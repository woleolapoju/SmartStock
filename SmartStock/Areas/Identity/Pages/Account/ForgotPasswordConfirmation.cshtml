@page
@{
    Layout = "/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Check your email";
}

<div class="login-wrap">
    <div class="login-card text-center">

        <div class="brand-mark" style="background:linear-gradient(135deg, #34d399, #10b981)">
            <i class="bi bi-envelope-check text-white"></i>
        </div>
        <h4 class="login-title mb-2">Check your email</h4>
        <p class="login-sub mb-4">
            If an account exists for that email address, we've sent a link to reset your password.
            The link will expire shortly, so please use it soon.
        </p>

        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-signin w-100">
            <i class="bi bi-box-arrow-in-right me-2"></i>Back to sign in
        </a>
    </div>

    <p class="text-center mt-3" style="color:rgba(255,255,255,0.25);font-size:.75rem">
        &copy; @DateTime.Now.Year SmartStock &mdash; Inventory Management System
    </p>
</div>
