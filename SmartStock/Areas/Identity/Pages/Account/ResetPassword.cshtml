@page
@model SmartStock.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    Layout = "/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<div class="login-wrap">
    <div class="login-card">

        <!-- Brand -->
        <div class="text-center mb-4">
            <div class="brand-mark">
                <i class="bi bi-shield-lock text-white"></i>
            </div>
            <h4 class="login-title mb-1">Reset your password</h4>
            <p class="login-sub mb-0">Choose a new password for your account</p>
        </div>

        <!-- Validation errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-login-error mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@err.ErrorMessage</span>
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Input.Code" value="@Model.Input?.Code" />

            <!-- Email (read-only, carried from the reset link) -->
            <div class="mb-3">
                <label class="form-label">Email address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input name="Input.Email" class="form-control" type="email"
                           value="@Model.Input?.Email" readonly
                           autocomplete="email" />
                </div>
            </div>

            <!-- New password -->
            <div class="mb-3">
                <label class="form-label">New password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input name="Input.Password" class="form-control" type="password"
                           placeholder="Enter a new password" autocomplete="new-password" id="pwdInput" />
                    <button class="btn btn-outline-secondary" type="button" id="togglePwd"
                            style="border-color:rgba(255,255,255,0.12);background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.45)">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <span class="text-danger small mt-1 d-block">
                    @Html.ValidationMessage("Input.Password")
                </span>
            </div>

            <!-- Confirm password -->
            <div class="mb-4">
                <label class="form-label">Confirm new password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input name="Input.ConfirmPassword" class="form-control" type="password"
                           placeholder="Re-enter the new password" autocomplete="new-password" />
                </div>
                <span class="text-danger small mt-1 d-block">
                    @Html.ValidationMessage("Input.ConfirmPassword")
                </span>
            </div>

            <button type="submit" class="btn btn-signin w-100">
                <i class="bi bi-check-circle me-2"></i>Reset password
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-area="Identity" asp-page="/Account/Login" style="color:rgba(255,255,255,0.45);font-size:.85rem;text-decoration:none">
                <i class="bi bi-arrow-left me-1"></i>Back to sign in
            </a>
        </p>
    </div>

    <p class="text-center mt-3" style="color:rgba(255,255,255,0.25);font-size:.75rem">
        &copy; @DateTime.Now.Year SmartStock &mdash; Inventory Management System
    </p>
</div>

@section Scripts {
<script>
    document.getElementById('togglePwd').addEventListener('click', function () {
        const input = document.getElementById('pwdInput');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    });
</script>
}
