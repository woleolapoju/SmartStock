@page
@model SmartStock.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item active">My Profile</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2"></i>My Profile</h4>
</div>

@if (Model.StatusMessage != null)
{
    <div class="alert alert-@(Model.StatusType ?? "info") alert-dismissible fade show d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-@(Model.StatusType == "success" ? "check-circle-fill" : Model.StatusType == "danger" ? "exclamation-triangle-fill" : "info-circle-fill")"></i>
        @Model.StatusMessage
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left: Avatar + account info -->
    <div class="col-lg-4">
        <div class="card p-4 text-center">
            <!-- Avatar circle -->
            <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                 style="width:88px;height:88px;font-size:1.8rem;background:linear-gradient(135deg,#4f8ef7,#7b5ea7)">
                @Model.Initials
            </div>
            <h5 class="mb-1 fw-bold">@Model.ProfileInput.FullName</h5>
            <p class="text-muted small mb-3">@Model.Email</p>

            <div class="d-flex flex-column gap-2">
                <!-- Role badge -->
                @{
                    var roleColor = Model.Role switch {
                        "Admin" => "danger",
                        "WarehouseManager" => "primary",
                        "StoreManager" => "success",
                        _ => "secondary"
                    };
                    var roleLabel = Model.Role switch {
                        "WarehouseManager" => "Warehouse Manager",
                        "StoreManager" => "Store Manager",
                        _ => Model.Role
                    };
                }
                <div class="d-flex align-items-center justify-content-between px-3 py-2 rounded"
                     style="background:var(--bs-light,#f8f9fa)">
                    <span class="text-muted small">Role</span>
                    <span class="badge bg-@roleColor">@roleLabel</span>
                </div>
                @if (Model.StoreName != null)
                {
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 rounded"
                         style="background:var(--bs-light,#f8f9fa)">
                        <span class="text-muted small">Store</span>
                        <span class="badge bg-info text-dark">@Model.StoreName</span>
                    </div>
                }
                <div class="d-flex align-items-center justify-content-between px-3 py-2 rounded"
                     style="background:var(--bs-light,#f8f9fa)">
                    <span class="text-muted small">Email</span>
                    <span class="small text-truncate ms-2" style="max-width:160px" title="@Model.Email">@Model.Email</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Edit forms -->
    <div class="col-lg-8">
        <!-- Profile details form -->
        <div class="card p-4 mb-4">
            <h6 class="fw-semibold mb-1">Personal Details</h6>
            <p class="text-muted small mb-4">Update your display name.</p>

            <form asp-page-handler="SaveProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3" style="max-width:400px">
                    <label asp-for="ProfileInput.FullName" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="ProfileInput.FullName" class="form-control" placeholder="Your full name" />
                    </div>
                    <span asp-validation-for="ProfileInput.FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3" style="max-width:400px">
                    <label class="form-label fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>
                    <div class="form-text">Email cannot be changed from this page.</div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i>Save Profile
                </button>
            </form>
        </div>

        <!-- Change password form -->
        <div class="card p-4">
            <h6 class="fw-semibold mb-1">Change Password</h6>
            <p class="text-muted small mb-4">Choose a strong password with at least 8 characters, including uppercase, lowercase, a number, and a symbol.</p>

            <form asp-page-handler="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3" style="max-width:400px">
                    <label asp-for="PasswordInput.CurrentPassword" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="PasswordInput.CurrentPassword" class="form-control" type="password"
                               placeholder="Current password" id="curPwd" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('curPwd','eyeCur')">
                            <i class="bi bi-eye" id="eyeCur"></i>
                        </button>
                    </div>
                    <span asp-validation-for="PasswordInput.CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3" style="max-width:400px">
                    <label asp-for="PasswordInput.NewPassword" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="PasswordInput.NewPassword" class="form-control" type="password"
                               placeholder="New password" id="newPwd" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('newPwd','eyeNew')">
                            <i class="bi bi-eye" id="eyeNew"></i>
                        </button>
                    </div>
                    <span asp-validation-for="PasswordInput.NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4" style="max-width:400px">
                    <label asp-for="PasswordInput.ConfirmPassword" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="PasswordInput.ConfirmPassword" class="form-control" type="password"
                               placeholder="Confirm new password" id="confPwd" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('confPwd','eyeConf')">
                            <i class="bi bi-eye" id="eyeConf"></i>
                        </button>
                    </div>
                    <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-outline-warning">
                    <i class="bi bi-key me-1"></i>Change Password
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    function togglePwd(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }
    </script>
}
