@page
@model SmartStock.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-wrap">
    <div class="login-card">

        <!-- Brand -->
        <div class="text-center mb-4">
            <div class="brand-mark">
                <i class="bi bi-key text-white"></i>
            </div>
            <h4 class="login-title mb-1">Forgot your password?</h4>
            <p class="login-sub mb-0">Enter your email and we'll send you a reset link</p>
        </div>

        <!-- Validation errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-login-error mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@err.ErrorMessage</span>
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="mb-4">
                <label class="form-label">Email address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input name="Input.Email" class="form-control" type="email"
                           value="@Model.Input?.Email"
                           placeholder="you@example.com" autocomplete="email" autofocus />
                </div>
                <span class="text-danger small mt-1 d-block">
                    @Html.ValidationMessage("Input.Email")
                </span>
            </div>

            <button type="submit" class="btn btn-signin w-100">
                <i class="bi bi-send me-2"></i>Send reset link
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-area="Identity" asp-page="/Account/Login" style="color:rgba(255,255,255,0.45);font-size:.85rem;text-decoration:none">
                <i class="bi bi-arrow-left me-1"></i>Back to sign in
            </a>
        </p>
    </div>

    <p class="text-center mt-3" style="color:rgba(255,255,255,0.25);font-size:.75rem">
        &copy; @DateTime.Now.Year SmartStock &mdash; Inventory Management System
    </p>
</div>
