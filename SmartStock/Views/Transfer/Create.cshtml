@model SmartStock.ViewModels.StockTransferViewModel
@{
    ViewData["Title"] = "Create Transfer";
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Transfers</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold">New Stock Transfer</h4>
</div>

<div class="row">
    <div class="col-md-9">
        <div class="card p-4">
            <form asp-action="Create" method="post" id="transferForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="WarehouseId" class="form-label fw-semibold">From Warehouse</label>
                        <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                            <option value="">-- Select Warehouse --</option>
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StoreId" class="form-label fw-semibold">To Store</label>
                        <select asp-for="StoreId" asp-items="Model.Stores" class="form-select">
                            <option value="">-- Select Store --</option>
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes (optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0">Transfer Items</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addItemBtn">
                        <i class="bi bi-plus-lg me-1"></i>Add Item
                    </button>
                </div>

                <div id="itemsContainer">
                    <!-- Items rendered here by JS -->
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-send me-1"></i>Create Transfer
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Products.Select(p => new { value = p.Value, text = p.Text })
    ));

    let itemIndex = 0;

    function addItem() {
        const container = document.getElementById('itemsContainer');
        const div = document.createElement('div');
        div.className = 'row g-2 align-items-end mb-3 item-row border-bottom pb-3';
        div.innerHTML = `
            <div class="col-md-7">
                <label class="form-label small fw-semibold">Product</label>
                <select name="Items[${itemIndex}].ProductId" class="form-select" required>
                    <option value="">-- Select Product --</option>
                    ${products.map(p => `<option value="${p.value}">${p.text}</option>`).join('')}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Quantity</label>
                <input type="number" name="Items[${itemIndex}].Quantity" class="form-control" min="1" value="1" required />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger w-100" onclick="this.closest('.item-row').remove()">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.appendChild(div);
        itemIndex++;
    }

    document.getElementById('addItemBtn').addEventListener('click', addItem);
    addItem(); // Add first row by default
</script>
}
