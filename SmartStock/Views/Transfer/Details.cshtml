@model SmartStock.Models.StockTransfer
@{
    ViewData["Title"] = Model.ReferenceNumber;
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Transfers</a></li>
            <li class="breadcrumb-item active">@Model.ReferenceNumber</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0 fw-bold">@Model.ReferenceNumber</h4>
            <span class="badge-@Model.Status.ToString().ToLower()">@Model.Status</span>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == SmartStock.Models.TransferStatus.Pending && (User.IsInRole("Admin") || User.IsInRole("WarehouseManager")))
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Approve</button>
                </form>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Cancel this transfer?')">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger">Cancel</button>
                </form>
            }
            @if (Model.Status == SmartStock.Models.TransferStatus.Approved && (User.IsInRole("Admin") || User.IsInRole("WarehouseManager")))
            {
                <form asp-action="Dispatch" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary"><i class="bi bi-truck me-1"></i>Dispatch</button>
                </form>
            }
            @if (Model.Status == SmartStock.Models.TransferStatus.Dispatched)
            {
                <form asp-action="Receive" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-success"><i class="bi bi-box-arrow-in-down me-1"></i>Mark Received</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Transfer Items</h6>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Product</th><th>SKU</th><th>Quantity</th></tr>
                    </thead>
                    <tbody>
                    @{int i = 1;}
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-muted">@(i++)</td>
                            <td class="fw-medium">@item.Product?.Name</td>
                            <td><code class="small">@item.Product?.SKU</code></td>
                            <td><span class="badge bg-primary">@item.Quantity</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Transfer Info</h6>
            <dl class="row mb-0">
                <dt class="col-6 text-muted small">From</dt>
                <dd class="col-6 small">@Model.Warehouse?.Name</dd>
                <dt class="col-6 text-muted small">To</dt>
                <dd class="col-6 small">@Model.Store?.Name</dd>
                <dt class="col-6 text-muted small">Created By</dt>
                <dd class="col-6 small">@(Model.CreatedBy?.FullName ?? "—")</dd>
                <dt class="col-6 text-muted small">Created At</dt>
                <dd class="col-6 small">@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm")</dd>
                @if (Model.ApprovedAt.HasValue)
                {
                    <dt class="col-6 text-muted small">Approved By</dt>
                    <dd class="col-6 small">@(Model.ApprovedBy?.FullName ?? "—")</dd>
                    <dt class="col-6 text-muted small">Approved At</dt>
                    <dd class="col-6 small">@Model.ApprovedAt.Value.ToString("MM/dd/yyyy HH:mm")</dd>
                }
                @if (Model.DispatchedAt.HasValue)
                {
                    <dt class="col-6 text-muted small">Dispatched At</dt>
                    <dd class="col-6 small">@Model.DispatchedAt.Value.ToString("MM/dd/yyyy HH:mm")</dd>
                }
                @if (Model.ReceivedAt.HasValue)
                {
                    <dt class="col-6 text-muted small">Received At</dt>
                    <dd class="col-6 small">@Model.ReceivedAt.Value.ToString("MM/dd/yyyy HH:mm")</dd>
                }
            </dl>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <hr/>
                <div class="text-muted small">Notes</div>
                <p class="small">@Model.Notes</p>
            }
        </div>

        <!-- Status Timeline -->
        <div class="card p-4 mt-3">
            <h6 class="fw-semibold mb-3">Status Timeline</h6>
            @{
                var statuses = new[] {
                    ("Pending", SmartStock.Models.TransferStatus.Pending, Model.CreatedAt as DateTime?),
                    ("Approved", SmartStock.Models.TransferStatus.Approved, Model.ApprovedAt),
                    ("Dispatched", SmartStock.Models.TransferStatus.Dispatched, Model.DispatchedAt),
                    ("Received", SmartStock.Models.TransferStatus.Received, Model.ReceivedAt)
                };
                int modelStatusInt = (int)Model.Status;
            }
            @foreach (var (label, status, date) in statuses)
            {
                int statusInt = (int)status;
                bool done = modelStatusInt >= statusInt && Model.Status != SmartStock.Models.TransferStatus.Cancelled;
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:28px;height:28px;background:@(done ? "#d1fae5" : "#f3f4f6")">
                        <i class="bi @(done ? "bi-check" : "bi-circle") small" style="color:@(done ? "#065f46" : "#9ca3af")"></i>
                    </div>
                    <div>
                        <div class="small fw-medium">@label</div>
                        @if (date.HasValue && done)
                        {
                            <div style="font-size:.7rem" class="text-muted">@date.Value.ToString("MM/dd HH:mm")</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
