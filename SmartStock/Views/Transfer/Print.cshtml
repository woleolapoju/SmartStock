@model SmartStock.Models.StockTransfer
@inject SmartStock.Interfaces.ISystemParameterService _sp
@{
    Layout = null;
    var p = await _sp.GetAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title>@Model.ReferenceNumber</title>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; font-size: 10pt; color: #111; background: #fff; padding: 32px 40px; max-width: 820px; margin: 0 auto; }

    /* ── Document header ── */
    .doc-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111; padding-bottom: 14px; margin-bottom: 18px; }
    .doc-header .company  { font-size: 20pt; font-weight: 800; letter-spacing: -.01em; }
    .doc-header .doc-type { font-size: 15pt; font-weight: bold; text-align: right; color: #333; }
    .doc-header .doc-ref  { font-size: 10pt; color: #555; text-align: right; margin-top: 4px; }

    /* ── Meta grid ── */
    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid #aaa; margin-bottom: 18px; }
    .meta-grid .cell { padding: 6px 10px; border-bottom: 1px solid #ddd; }
    .meta-grid .cell:nth-child(odd) { background: #f7f7f7; border-right: 1px solid #aaa; }
    .meta-grid .cell .label { font-size: 7.5pt; text-transform: uppercase; color: #777; letter-spacing: .06em; margin-bottom: 1px; }
    .meta-grid .cell .value { font-weight: bold; font-size: 10pt; }

    /* ── Route banner ── */
    .route-banner { display: flex; align-items: center; gap: 12px; background: #f0f2f8; border: 1px solid #c8cfe0; border-radius: 6px; padding: 10px 16px; margin-bottom: 18px; }
    .route-banner .loc { flex: 1; }
    .route-banner .loc .loc-type { font-size: 7.5pt; text-transform: uppercase; color: #777; letter-spacing: .06em; }
    .route-banner .loc .loc-name { font-size: 12pt; font-weight: bold; }
    .route-banner .arrow { font-size: 20pt; color: #555; flex-shrink: 0; }

    /* ── Status badge ── */
    .status-badge { display: inline-block; padding: 2px 8px; border: 1px solid #aaa; border-radius: 4px; font-size: 9pt; }

    /* ── Items table ── */
    table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
    thead th { background: #1a1f2e; color: #fff; padding: 6px 8px; font-size: 9pt; text-transform: uppercase; letter-spacing: .04em; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    tbody td { padding: 5px 8px; border-bottom: 1px solid #ddd; font-size: 9.5pt; }
    tbody tr:last-child td { border-bottom: none; }
    tfoot td { padding: 7px 8px; border-top: 2px solid #111; font-weight: bold; }
    .text-end { text-align: right; }
    .text-muted { color: #666; font-size: 8.5pt; }

    /* ── Summary bar ── */
    .summary-bar { display: flex; gap: 32px; border-top: 2px solid #111; padding: 8px 8px 0; font-size: 9.5pt; }
    .summary-bar .s-item .s-label { font-size: 7.5pt; text-transform: uppercase; color: #777; }
    .summary-bar .s-item .s-val   { font-weight: bold; font-size: 12pt; }

    /* ── Notes ── */
    .notes-box { border: 1px solid #bbb; border-radius: 4px; padding: 8px 12px; margin-top: 16px; font-size: 9pt; color: #444; }
    .notes-box .notes-label { font-size: 7.5pt; text-transform: uppercase; color: #888; margin-bottom: 4px; letter-spacing: .06em; }

    /* ── Signature row ── */
    .sig-row { display: flex; gap: 40px; margin-top: 36px; }
    .sig-row .sig { flex: 1; border-top: 1px solid #555; padding-top: 4px; font-size: 8.5pt; color: #555; }

    /* ── No-print controls ── */
    .no-print { margin-top: 24px; display: flex; gap: 10px; }
    .no-print button { padding: 7px 22px; font-size: 10pt; cursor: pointer; border-radius: 4px; border: 1px solid #555; background: #fff; }
    .no-print button.btn-primary { background: #1a1f2e; color: #fff; border-color: #1a1f2e; }

    @@media print {
        @@page { margin: 1.5cm; }
        body { padding: 0; }
        .no-print { display: none !important; }
        .route-banner { background: #f0f0f0 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>
</head>
<body>

<div class="doc-header">
    <div>
        <div class="company">@p.OwnerName</div>
        <div style="font-size:8.5pt; color:#777; margin-top:3px">Inventory Management System</div>
    </div>
    <div>
        <div class="doc-type">Stock Transfer Note</div>
        <div class="doc-ref">@Model.ReferenceNumber</div>
    </div>
</div>

<div class="route-banner">
    <div class="loc">
        <div class="loc-type">From (Warehouse)</div>
        <div class="loc-name">@(Model.Warehouse?.Name ?? "—")</div>
    </div>
    <div class="arrow">&#8594;</div>
    <div class="loc">
        <div class="loc-type">To (Store)</div>
        <div class="loc-name">@(Model.Store?.Name ?? "—")</div>
    </div>
</div>

<div class="meta-grid">
    <div class="cell">
        <div class="label">Created</div>
        <div class="value">@Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")</div>
    </div>
    <div class="cell">
        <div class="label">Status</div>
        <div class="value"><span class="status-badge">@Model.Status</span></div>
    </div>
    <div class="cell">
        <div class="label">Created By</div>
        <div class="value">@(Model.CreatedBy?.FullName ?? "—")</div>
    </div>
    <div class="cell">
        <div class="label">Approved By</div>
        <div class="value">@(Model.ApprovedBy?.FullName ?? "—")</div>
    </div>
    @if (Model.DispatchedAt.HasValue)
    {
    <div class="cell">
        <div class="label">Dispatched</div>
        <div class="value">@Model.DispatchedAt.Value.ToString("MMMM dd, yyyy")</div>
    </div>
    }
    @if (Model.ReceivedAt.HasValue)
    {
    <div class="cell">
        <div class="label">Received</div>
        <div class="value">@Model.ReceivedAt.Value.ToString("MMMM dd, yyyy")</div>
    </div>
    }
</div>

<table>
    <thead>
        <tr>
            <th style="width:34px">#</th>
            <th>Product</th>
            <th>SKU</th>
            <th class="text-end" style="width:90px">Quantity</th>
        </tr>
    </thead>
    <tbody>
    @{ int row = 1; }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td class="text-muted">@(row++)</td>
            <td>@item.Product?.Name</td>
            <td class="text-muted">@item.Product?.SKU</td>
            <td class="text-end" style="font-weight:600">@item.Quantity</td>
        </tr>
    }
    </tbody>
</table>

<div class="summary-bar">
    <div class="s-item">
        <div class="s-label">Total Lines</div>
        <div class="s-val">@Model.Items.Count</div>
    </div>
    <div class="s-item">
        <div class="s-label">Total Units</div>
        <div class="s-val">@Model.Items.Sum(i => i.Quantity)</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="notes-box">
        <div class="notes-label">Notes</div>
        @Model.Notes
    </div>
}

<div class="sig-row no-print">
    <div class="sig">Dispatched By</div>
    <div class="sig">Received By</div>
    <div class="sig">Date</div>
</div>

<div class="no-print">
    <button class="btn-primary" onclick="window.print()">&#128438; Print</button>
    <button onclick="window.close()">Close</button>
</div>

</body>
</html>
