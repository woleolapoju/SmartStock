@model IEnumerable<SmartStock.Models.StockTransfer>
@{
    ViewData["Title"] = "Stock Transfers";
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Stock Transfers</h4>
        <p class="text-muted mb-0 small">@Model.Count() transfers</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Transfer
        </a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Reference</th><th>Warehouse</th><th>Store</th><th>Status</th><th>Created</th><th>Items</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="fw-medium">@t.ReferenceNumber</td>
                    <td>@t.Warehouse?.Name</td>
                    <td>@t.Store?.Name</td>
                    <td><span class="badge-@t.Status.ToString().ToLower()">@t.Status</span></td>
                    <td class="text-muted small">@t.CreatedAt.ToString("MM/dd/yyyy")</td>
                    <td class="text-muted">@t.Items.Count items</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">No transfers yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
