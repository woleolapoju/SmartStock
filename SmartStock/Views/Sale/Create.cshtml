@model SmartStock.ViewModels.CreateSaleViewModel
@{
    ViewData["Title"] = "New Sale (POS)";
    var categories = ViewBag.Categories as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Sales</a></li>
            <li class="breadcrumb-item active">New Sale</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold"><i class="bi bi-cart3 me-2"></i>Point of Sale</h4>
</div>

<div class="row g-3">
    <!-- Cart Builder -->
    <div class="col-md-8">
        <div class="card p-4">
            <form asp-action="Create" method="post" id="saleForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="StoreId" class="form-label fw-semibold">Store</label>
                        <select asp-for="StoreId" asp-items="Model.Stores" class="form-select" id="storeSelect">
                            <option value="">-- Select Store --</option>
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Discount" class="form-label fw-semibold">Order Discount ($)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Discount" class="form-control no-select2" type="number" step="0.01" min="0" id="orderDiscount" value="0" />
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="1"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0">Cart Items</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addItemBtn">
                        <i class="bi bi-plus-lg me-1"></i>Add Item
                    </button>
                </div>

                <div id="itemsContainer"></div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i>Complete Sale
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Order Summary -->
    <div class="col-md-4">
        <div class="card p-4 sticky-top" style="top:1rem">
            <h6 class="fw-semibold mb-3">Order Summary</h6>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Subtotal</span>
                <span id="summarySubtotal">$0.00</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Tax (8%)</span>
                <span id="summaryTax">$0.00</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Discount</span>
                <span id="summaryDiscount" class="text-danger">-$0.00</span>
            </div>
            <hr/>
            <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Total</span>
                <span id="summaryTotal" class="text-primary">$0.00</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        categories.Select(c => new { value = c.Value, text = c.Text })
    ));
    let itemIndex = 0;
    const TAX_RATE = 0.08;

    function getStoreId() {
        return document.getElementById('storeSelect').value;
    }

    async function loadProducts(categoryId) {
        const storeId = getStoreId();
        if (!storeId) return [];
        const url = `/api/products/for-sale?storeId=${storeId}${categoryId ? '&categoryId=' + categoryId : ''}`;
        const res = await fetch(url);
        return res.ok ? await res.json() : [];
    }

    async function addItem() {
        const container = document.getElementById('itemsContainer');
        const idx = itemIndex++;
        const div = document.createElement('div');
        div.className = 'row g-2 align-items-end mb-3 item-row border-bottom pb-3';
        div.innerHTML = `
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Category</label>
                <select class="form-select category-select" id="cat-${idx}" data-idx="${idx}"
                        data-skip-select2="true">
                    <option value="">All categories</option>
                    ${categories.map(c => `<option value="${c.value}">${c.text}</option>`).join('')}
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Product <span class="text-muted small">(available)</span></label>
                <select name="Items[${idx}].ProductId" class="form-select product-select" id="prod-${idx}" required
                        data-skip-select2="true">
                    <option value="">Select store first</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Qty</label>
                <input type="number" name="Items[${idx}].Quantity" class="form-control qty-input" min="1" value="1" required oninput="recalculate()" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Unit Price ($)</label>
                <input type="number" name="Items[${idx}].UnitPrice" class="form-control price-input no-select2" step="0.01" min="0" required oninput="recalculate()" />
            </div>
            <div class="col-md-1">
                <label class="form-label small fw-semibold">&nbsp;</label>
                <button type="button" class="btn btn-outline-danger w-100" onclick="this.closest('.item-row').remove(); recalculate()">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            <input type="hidden" name="Items[${idx}].Discount" value="0" />
        `;
        container.appendChild(div);

        $(`#cat-${idx}`).select2({ theme: 'bootstrap-5', width: '100%', placeholder: 'All categories', allowClear: true });
        $(`#prod-${idx}`).select2({ theme: 'bootstrap-5', width: '100%', placeholder: 'Select product', allowClear: true });

        $(`#cat-${idx}`).on('change', async function() {
            await refreshProducts(idx, this.value);
        });

        $(`#prod-${idx}`).on('change', function() {
            const sel = document.getElementById(`prod-${idx}`);
            const opt = sel.options[sel.selectedIndex];
            if (opt && opt.dataset.price) {
                sel.closest('.item-row').querySelector('.price-input').value = parseFloat(opt.dataset.price).toFixed(2);
                recalculate();
            }
        });

        await refreshProducts(idx, '');
        recalculate();
    }

    async function refreshProducts(idx, categoryId) {
        const sel = document.getElementById(`prod-${idx}`);
        const products = await loadProducts(categoryId);
        sel.innerHTML = products.length
            ? products.map(p => `<option value="${p.id}" data-price="${p.price}">${p.name} (${p.sku}) — ${p.available} avail</option>`).join('')
            : '<option value="">No products with stock in this store</option>';
        if (products.length) {
            const row = sel.closest('.item-row');
            row.querySelector('.price-input').value = parseFloat(products[0].price).toFixed(2);
        }
        $(`#prod-${idx}`).trigger('change');
        recalculate();
    }

    // Re-load products in all rows when store changes
    document.getElementById('storeSelect').addEventListener('change', async function() {
        const rows = document.querySelectorAll('.item-row');
        for (let i = 0; i < rows.length; i++) {
            const catSel = rows[i].querySelector('.category-select');
            const idx = catSel?.dataset.idx;
            if (idx !== undefined) await refreshProducts(idx, catSel.value || '');
        }
    });

    function recalculate() {
        let subtotal = 0;
        document.querySelectorAll('.item-row').forEach(row => {
            const qty = parseFloat(row.querySelector('.qty-input')?.value || 0);
            const price = parseFloat(row.querySelector('.price-input')?.value || 0);
            subtotal += qty * price;
        });
        const discount = parseFloat(document.getElementById('orderDiscount').value || 0);
        const tax = subtotal * TAX_RATE;
        const total = subtotal + tax - discount;
        document.getElementById('summarySubtotal').textContent = '$' + subtotal.toFixed(2);
        document.getElementById('summaryTax').textContent = '$' + tax.toFixed(2);
        document.getElementById('summaryDiscount').textContent = '-$' + discount.toFixed(2);
        document.getElementById('summaryTotal').textContent = '$' + total.toFixed(2);
    }

    document.getElementById('addItemBtn').addEventListener('click', addItem);
    document.getElementById('orderDiscount').addEventListener('input', recalculate);
    addItem();
</script>
}
