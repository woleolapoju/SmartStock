@model SmartStock.Models.Sale
@inject SmartStock.Interfaces.ISystemParameterService _receiptSysParams
@{
    ViewData["Title"] = "Receipt - " + Model.ReferenceNumber;
    Layout = null;
    var _receiptParam = await _receiptSysParams.GetAsync();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <title>Receipt @Model.ReferenceNumber</title>
    <style>
        body { font-family: 'Courier New', monospace; max-width: 320px; margin: 20px auto; font-size: 13px; }
        .center { text-align: center; }
        .bold { font-weight: bold; }
        hr { border: none; border-top: 1px dashed #000; }
        .row { display: flex; justify-content: space-between; }
        .total-row { font-size: 15px; font-weight: bold; }
        @@media print { body { margin: 0; } .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="center bold" style="font-size:18px">@_receiptParam.OwnerName</div>
    <div class="center">@Model.Store?.Name</div>
    <div class="center" style="font-size:11px">@Model.SaleDate.ToString("MM/dd/yyyy HH:mm:ss")</div>
    <hr/>
    <div class="center bold">@Model.ReferenceNumber</div>
    <hr/>
    @foreach (var item in Model.Items)
    {
        <div class="row">
            <span>@item.Product?.Name</span>
        </div>
        <div class="row">
            <span>  @item.Quantity x @_receiptParam.CurrencySymbol@item.UnitPrice.ToString("N2")</span>
            <span>@_receiptParam.CurrencySymbol@item.LineTotal.ToString("N2")</span>
        </div>
    }
    <hr/>
    <div class="row"><span>Subtotal</span><span>@_receiptParam.CurrencySymbol@Model.SubTotal.ToString("N2")</span></div>
    <div class="row"><span>Tax @(Model.SubTotal > 0 ? "(" + Math.Round(Model.TaxAmount / Model.SubTotal * 100, 2) + "%)" : "")</span><span>@_receiptParam.CurrencySymbol@Model.TaxAmount.ToString("N2")</span></div>
    @if (Model.Discount > 0)
    {
        <div class="row"><span>Discount</span><span>-@_receiptParam.CurrencySymbol@Model.Discount.ToString("N2")</span></div>
    }
    <hr/>
    <div class="row total-row"><span>TOTAL</span><span>@_receiptParam.CurrencySymbol@Model.TotalAmount.ToString("N2")</span></div>
    <hr/>
    <div class="center" style="font-size:11px">Thank you for your purchase!</div>
    <br/>
    <div class="center no-print">
        <button onclick="window.print()" style="padding:6px 20px;cursor:pointer">Print Receipt</button>
        <button onclick="window.close()" style="padding:6px 20px;cursor:pointer;margin-left:8px">Close</button>
    </div>
</body>
</html>
