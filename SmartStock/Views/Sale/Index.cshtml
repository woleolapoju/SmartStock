@model IEnumerable<SmartStock.Models.Sale>
@{
    ViewData["Title"] = "Sales";
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Sales</h4>
        <p class="text-muted mb-0 small">@Model.Count() transactions</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("StoreManager") || User.IsInRole("Staff"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-cart-plus me-1"></i>New Sale (POS)
        </a>
    }
</div>

<!-- Filters -->
<div class="card mb-3 p-3">
    <form method="get" class="row g-2 align-items-end">
        @if ((bool)(ViewBag.IsStoreLocked ?? false))
        {
            <!-- Store-restricted users: show their store as a read-only badge -->
            <div class="col-12 col-md-auto">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2" style="font-size:.85rem">
                    <i class="bi bi-shop me-1"></i>@ViewBag.StoreName
                </span>
            </div>
            <input type="hidden" name="storeId" value="@ViewBag.SelectedStoreId" />
        }
        else
        {
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Store</label>
                <select name="storeId" class="form-select">
                    <option value="">All Stores</option>
                    @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Stores)
                    {
                        if (s.Value == ViewBag.SelectedStoreId?.ToString())
                        {
                            <option value="@s.Value" selected>@s.Text</option>
                        }
                        else
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="col-md-2">
            <label class="form-label small fw-semibold">From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        @if (!(bool)(ViewBag.IsStoreLocked ?? false))
        {
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        }
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Reference</th><th>Store</th><th>Cashier</th><th>Items</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-medium">@s.ReferenceNumber</td>
                    <td>@s.Store?.Name</td>
                    <td class="text-muted small">@(s.Cashier?.FullName ?? s.Cashier?.Email ?? "—")</td>
                    <td class="text-muted">@s.Items.Count</td>
                    <td class="fw-bold">@ViewBag.CurrencySymbol@s.TotalAmount.ToString("N2")</td>
                    <td><span class="badge-@s.Status.ToString().ToLower()">@s.Status</span></td>
                    <td class="text-muted small">@s.SaleDate.ToString("MM/dd/yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center py-4 text-muted">No sales found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
