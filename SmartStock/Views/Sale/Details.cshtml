@model SmartStock.Models.Sale
@{
    ViewData["Title"] = Model.ReferenceNumber;
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Sales</a></li>
            <li class="breadcrumb-item active">@Model.ReferenceNumber</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0 fw-bold">@Model.ReferenceNumber</h4>
            <span class="badge-@Model.Status.ToString().ToLower()">@Model.Status</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">
                <i class="bi bi-printer me-1"></i>Receipt
            </a>
            @if (Model.Status == SmartStock.Models.SaleStatus.Completed && (User.IsInRole("Admin") || User.IsInRole("StoreManager")))
            {
                <form asp-action="Void" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Void this sale?')">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger">Void Sale</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Sale Items</h6>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead class="table-light">
                        <tr><th>Product</th><th>SKU</th><th>Qty</th><th>Unit Price</th><th>Discount</th><th class="text-end">Line Total</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium">@item.Product?.Name</td>
                            <td><code class="small">@item.Product?.SKU</code></td>
                            <td>@item.Quantity</td>
                            <td>@ViewBag.CurrencySymbol@item.UnitPrice.ToString("N2")</td>
                            <td class="text-muted">@(item.Discount > 0 ? "-$"+item.Discount.ToString("N2") : "—")</td>
                            <td class="text-end fw-bold">@ViewBag.CurrencySymbol@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="5" class="text-end text-muted">Subtotal</td><td class="text-end">@ViewBag.CurrencySymbol@Model.SubTotal.ToString("N2")</td></tr>
                        <tr><td colspan="5" class="text-end text-muted">Tax @(Model.SubTotal > 0 ? "(" + Math.Round(Model.TaxAmount / Model.SubTotal * 100, 2) + "%)" : "")</td><td class="text-end">@ViewBag.CurrencySymbol@Model.TaxAmount.ToString("N2")</td></tr>
                        @if (Model.Discount > 0)
                        {
                            <tr><td colspan="5" class="text-end text-muted">Discount</td><td class="text-end text-danger">-@ViewBag.CurrencySymbol@Model.Discount.ToString("N2")</td></tr>
                        }
                        <tr class="fw-bold fs-6">
                            <td colspan="5" class="text-end">Total</td>
                            <td class="text-end text-primary">@ViewBag.CurrencySymbol@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Sale Info</h6>
            <dl class="row mb-0">
                <dt class="col-6 text-muted small">Store</dt>
                <dd class="col-6 small">@Model.Store?.Name</dd>
                <dt class="col-6 text-muted small">Cashier</dt>
                <dd class="col-6 small">@(Model.Cashier?.FullName ?? Model.Cashier?.Email ?? "—")</dd>
                <dt class="col-6 text-muted small">Sale Date</dt>
                <dd class="col-6 small">@Model.SaleDate.ToString("MM/dd/yyyy HH:mm")</dd>
            </dl>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <hr /><p class="small text-muted">@Model.Notes</p>
            }
        </div>
    </div>
</div>
