@model IEnumerable<SmartStock.ViewModels.InventoryViewModel>
@{
    ViewData["Title"] = "Store Inventory";
    var storeId = (int)(ViewBag.SelectedStoreId ?? 0);
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("StoreManager");
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Store Inventory</h4>
        <p class="text-muted mb-0 small">@Model.Count() SKUs tracked</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Warehouse" class="btn btn-outline-secondary"><i class="bi bi-building me-1"></i>Warehouse View</a>
        <a asp-action="LowStock" class="btn btn-outline-warning"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</a>
    </div>
</div>

<div class="card mb-3 p-3">
    @if ((bool)(ViewBag.IsStoreLocked ?? false))
    {
        var lockedStoreName = ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Stores).FirstOrDefault()?.Text ?? "Your Store";
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shop text-success"></i>
            <span class="fw-semibold">@lockedStoreName</span>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 ms-1">Assigned Store</span>
        </div>
    }
    else
    {
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Select Store</label>
                <select name="storeId" class="form-select" asp-items="ViewBag.Stores" onchange="this.form.submit()" data-skip-select2="true"></select>
            </div>
        </form>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th><th>SKU</th><th>Category</th>
                    <th>Quantity</th>
                    <th>Reorder Level</th>
                    <th>Status</th><th>Last Updated</th>
                    @if (canEdit) { <th style="width:90px"></th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-medium">@item.ProductName</td>
                    <td><code class="small">@item.SKU</code></td>
                    <td><span class="badge bg-light text-dark">@item.CategoryName</span></td>
                    <td>
                        <span class="fw-bold @(item.IsLowStock ? "text-danger" : "text-success")">@item.Quantity</span>
                    </td>
                    <td>
                        @if (canEdit)
                        {
                            <form asp-action="UpdateReorderLevel" method="post" class="d-flex gap-1 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="inventoryId" value="@item.InventoryId" />
                                <input type="hidden" name="locationType" value="@((int)item.LocationType)" />
                                <input type="hidden" name="locationId" value="@storeId" />
                                <input type="number" name="reorderLevel" value="@item.ReorderLevel"
                                       class="form-control form-control-sm" style="width:70px" min="0" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Save">
                                    <i class="bi bi-check"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">@item.ReorderLevel</span>
                        }
                    </td>
                    <td>
                        @if (item.IsLowStock) { <span class="badge-cancelled">Low Stock</span> }
                        else { <span class="badge-received">OK</span> }
                    </td>
                    <td class="text-muted small">@item.LastUpdated.ToString("MM/dd HH:mm")</td>
                    @if (canEdit)
                    {
                        <td>
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                    data-bs-target="#adjustModal"
                                    data-product-id="@item.ProductId"
                                    data-location-type="2"
                                    data-location-id="@storeId"
                                    data-product-name="@item.ProductName"
                                    data-qty="@item.Quantity">
                                <i class="bi bi-sliders"></i>
                            </button>
                        </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center py-4 text-muted">No inventory in this store yet. Create a transfer to add stock.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (canEdit)
{
    <div class="modal fade" id="adjustModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Inventory" asp-action="Adjust" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LocationType" id="adj-locationType" />
                    <input type="hidden" name="LocationId" id="adj-locationId" />
                    <input type="hidden" name="ProductId" id="adj-productId" />
                    <div class="modal-header">
                        <h5 class="modal-title">Adjust Stock — <span id="adj-productName"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">Current quantity: <strong id="adj-currentQty"></strong></p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Quantity Change</label>
                            <input type="number" name="QuantityChange" class="form-control no-select2" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reason</label>
                            <input type="text" name="Reason" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Apply</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    document.getElementById('adjustModal')?.addEventListener('show.bs.modal', function(e) {
        const btn = e.relatedTarget;
        document.getElementById('adj-productId').value = btn.dataset.productId;
        document.getElementById('adj-locationType').value = btn.dataset.locationType;
        document.getElementById('adj-locationId').value = btn.dataset.locationId;
        document.getElementById('adj-productName').textContent = btn.dataset.productName;
        document.getElementById('adj-currentQty').textContent = btn.dataset.qty;
    });
</script>
}
