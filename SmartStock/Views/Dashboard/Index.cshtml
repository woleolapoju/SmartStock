@model SmartStock.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    bool isRestricted = (bool)(ViewBag.IsStoreRestricted ?? false);
    string scopeLabel = Model.SelectedStoreName != null ? $"— {Model.SelectedStoreName}" : "";
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Dashboard @(Model.SelectedStoreName != null ? $"— {Model.SelectedStoreName}" : "")</h4>
        <p class="text-muted mb-0 small">
            @if (isRestricted && Model.SelectedStoreName != null)
            {
                <span><i class="bi bi-shop me-1"></i>Showing data for your assigned store</span>
            }
            else if (Model.SelectedStoreId != null)
            {
                <span><i class="bi bi-funnel me-1"></i>Filtered to store view</span>
            }
            else
            {
                <span>Overview of all SmartStock operations</span>
            }
        </p>
    </div>

    @if (!isRestricted)
    {
        <!-- Store filter for Admin / WarehouseManager -->
        <form method="get" class="d-flex align-items-center gap-2">
            <select name="storeId" class="form-select form-select-sm" style="min-width:180px"
                    data-skip-select2="true" onchange="this.form.submit()">
                <option value="">All Stores</option>
                @foreach (var s in Model.Stores)
                {
                    if (s.Value == Model.SelectedStoreId?.ToString())
                    {
                        <option value="@s.Value" selected>@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
            @if (Model.SelectedStoreId != null)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    }
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#eff6ff"><i class="bi bi-box-seam text-primary"></i></div>
                <div>
                    <div class="text-muted small">Total Products</div>
                    <div class="fs-4 fw-bold">@Model.TotalProducts</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#f0fdf4"><i class="bi bi-stack text-success"></i></div>
                <div>
                    <div class="text-muted small">Stock Units@(Model.SelectedStoreName != null ? " (Store)" : "")</div>
                    <div class="fs-4 fw-bold">@Model.TotalStockUnits.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fffbeb"><i class="bi bi-exclamation-triangle text-warning"></i></div>
                <div>
                    <div class="text-muted small">Low Stock Alerts</div>
                    <div class="fs-4 fw-bold text-warning">@Model.LowStockCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fdf4ff"><i class="bi bi-cash-stack" style="color:#a855f7"></i></div>
                <div>
                    <div class="text-muted small">Today's Sales</div>
                    <div class="fs-4 fw-bold">@ViewBag.CurrencySymbol@Model.TodaySalesAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fff1f2"><i class="bi bi-receipt text-danger"></i></div>
                <div>
                    <div class="text-muted small">Today's Transactions</div>
                    <div class="fs-4 fw-bold">@Model.TodaySalesCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#f0f9ff"><i class="bi bi-arrow-left-right text-info"></i></div>
                <div>
                    <div class="text-muted small">Pending Transfers</div>
                    <div class="fs-4 fw-bold">@Model.PendingTransfers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#f0fdf4"><i class="bi bi-shop text-success"></i></div>
                <div>
                    <div class="text-muted small">@(Model.SelectedStoreName != null ? "Store" : "Active Stores")</div>
                    <div class="fs-4 fw-bold">@Model.TotalStores</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#eff6ff"><i class="bi bi-building text-primary"></i></div>
                <div>
                    <div class="text-muted small">Warehouses</div>
                    <div class="fs-4 fw-bold">@Model.TotalWarehouses</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">
                Monthly Sales Revenue
                @if (Model.SelectedStoreName != null)
                { <span class="badge bg-primary bg-opacity-10 text-primary fw-normal ms-1">@Model.SelectedStoreName</span> }
            </h6>
            <canvas id="salesChart" height="110"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Stock by Category</h6>
            <canvas id="categoryChart" height="200"></canvas>
        </div>
    </div>
</div>

<!-- Bottom Row -->
<div class="row g-3">
    <div class="col-md-5">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0">Recent Sales</h6>
                <a asp-controller="Sale" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            @if (Model.RecentSales.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead><tr><th>Reference</th><th>Store</th><th>Total</th><th>Date</th></tr></thead>
                        <tbody>
                        @foreach (var sale in Model.RecentSales)
                        {
                            <tr>
                                <td><a asp-controller="Sale" asp-action="Details" asp-route-id="@sale.Id" class="text-decoration-none fw-medium">@sale.ReferenceNumber</a></td>
                                <td class="text-muted small">@sale.Store?.Name</td>
                                <td class="fw-medium">@ViewBag.CurrencySymbol@sale.TotalAmount.ToString("N2")</td>
                                <td class="text-muted small">@sale.SaleDate.ToString("MM/dd HH:mm")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            { <p class="text-muted small text-center py-3">No sales yet.</p> }
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0 text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</h6>
                <a asp-controller="Inventory" asp-action="LowStock" class="btn btn-sm btn-outline-warning">View All</a>
            </div>
            @if (Model.LowStockItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Product</th><th>Location</th><th>Qty</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.LowStockItems)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium small">@item.ProductName</div>
                                    <div class="text-muted" style="font-size:.75rem">@item.SKU</div>
                                </td>
                                <td class="text-muted small">@item.LocationName</td>
                                <td><span class="badge bg-danger">@item.Quantity</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            { <p class="text-success small text-center py-3"><i class="bi bi-check-circle me-1"></i>All stock levels OK.</p> }
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0">Recent Transfers</h6>
                <a asp-controller="Transfer" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            @foreach (var t in Model.RecentTransfers)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="small fw-medium">@t.ReferenceNumber</div>
                        <div class="text-muted" style="font-size:.75rem">@t.Store?.Name</div>
                    </div>
                    <span class="badge-@t.Status.ToString().ToLower()">@t.Status</span>
                </div>
            }
            @if (!Model.RecentTransfers.Any())
            { <p class="text-muted small text-center py-3">No transfers yet.</p> }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('salesChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
            datasets: [{
                label: 'Revenue ($)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData)),
                backgroundColor: 'rgba(79,124,255,0.7)',
                borderColor: '#4f7cff',
                borderWidth: 2,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.05)' },
                     ticks: { callback: v => '$' + v.toLocaleString() } },
                x: { grid: { display: false } }
            }
        }
    });

    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryStockLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryStockData)),
                backgroundColor: ['#4f7cff','#22c55e','#f59e0b','#ef4444','#8b5cf6','#06b6d4'],
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } },
            cutout: '65%'
        }
    });
</script>
}
