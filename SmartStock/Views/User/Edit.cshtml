@model SmartStock.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold"><i class="bi bi-pencil me-2"></i>Edit User — @Model.FullName</h4>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <h6 class="fw-semibold text-muted mb-3 text-uppercase" style="font-size:.75rem;letter-spacing:.08em">
                    Account Details
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" readonly
                               style="background:#f9f9f9" title="Email cannot be changed" />
                        <div class="form-text text-muted">Email is used as username and cannot be changed.</div>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1-555-0100" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <hr />
                <h6 class="fw-semibold text-muted mb-3 text-uppercase" style="font-size:.75rem;letter-spacing:.08em">
                    Role & Access
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" asp-items="Model.Roles" class="form-select" id="roleSelect"
                                onchange="toggleStoreField()">
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6" id="storeField">
                        <label asp-for="StoreId" class="form-label fw-semibold"></label>
                        <select asp-for="StoreId" asp-items="Model.Stores" class="form-select">
                            <option value="">-- No Store --</option>
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" id="isActiveSwitch" />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                Account Active
                                <span class="text-muted small fw-normal">— inactive users cannot log in</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>Save Changes
                    </button>
                    <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-key me-1"></i>Reset Password
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">User Info</h6>
            <dl class="row small mb-0">
                <dt class="col-5 text-muted">User ID</dt>
                <dd class="col-7"><code class="small">@Model.Id</code></dd>
                <dt class="col-5 text-muted">Email</dt>
                <dd class="col-7">@Model.Email</dd>
                <dt class="col-5 text-muted">Current Role</dt>
                <dd class="col-7">
                    @{
                        var badgeClass = Model.Role switch {
                            "Admin" => "bg-danger",
                            "WarehouseManager" => "bg-primary",
                            "StoreManager" => "bg-success",
                            "Staff" => "bg-secondary",
                            _ => "bg-light text-dark"
                        };
                    }
                    <span class="badge @badgeClass">@(string.IsNullOrEmpty(Model.Role) ? "No Role" : Model.Role)</span>
                </dd>
                <dt class="col-5 text-muted">Status</dt>
                <dd class="col-7">
                    @if (Model.IsActive) { <span class="badge-received">Active</span> }
                    else { <span class="badge-cancelled">Inactive</span> }
                </dd>
            </dl>
        </div>
        <div class="alert alert-info mt-3 small">
            <i class="bi bi-info-circle me-1"></i>
            To change this user's password, use the <strong>Reset Password</strong> button. Passwords cannot be viewed.
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleStoreField() {
        const role = document.getElementById('roleSelect').value;
        const storeField = document.getElementById('storeField');
        storeField.style.display = (role === 'StoreManager' || role === 'Staff') ? '' : 'none';
    }
    toggleStoreField();
</script>
}
