@model SmartStock.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
            <li class="breadcrumb-item active">Reset Password</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold"><i class="bi bi-key me-2"></i>Reset Password — @ViewBag.UserName</h4>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card p-4">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control" type="password" id="newPwdInput"
                                   placeholder="Min 8 characters" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('newPwdInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="mt-1">
                            <div id="strengthBar" class="progress" style="height:4px;display:none">
                                <div id="strengthFill" class="progress-bar" style="width:0%"></div>
                            </div>
                            <small id="strengthLabel" class="text-muted"></small>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPwdInput"
                                   placeholder="Repeat new password" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('confirmPwdInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-key me-1"></i>Reset Password
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4">
            <h6 class="fw-semibold mb-2"><i class="bi bi-shield-lock me-2 text-warning"></i>Password Requirements</h6>
            <ul class="small text-muted mb-0 ps-3">
                <li>Minimum 8 characters</li>
                <li>At least one uppercase letter (A–Z)</li>
                <li>At least one lowercase letter (a–z)</li>
                <li>At least one digit (0–9)</li>
                <li>At least one special character (!@@#$%...)</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const isText = input.type === 'text';
        input.type = isText ? 'password' : 'text';
        btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
    }

    document.getElementById('newPwdInput').addEventListener('input', function() {
        const val = this.value;
        const bar = document.getElementById('strengthBar');
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');

        if (!val) { bar.style.display = 'none'; label.textContent = ''; return; }
        bar.style.display = '';

        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[a-z]/.test(val)) score++;
        if (/\d/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
            { pct: '20%', cls: 'bg-danger',  txt: 'Very weak' },
            { pct: '40%', cls: 'bg-warning',  txt: 'Weak' },
            { pct: '60%', cls: 'bg-info',     txt: 'Fair' },
            { pct: '80%', cls: 'bg-primary',  txt: 'Strong' },
            { pct: '100%',cls: 'bg-success',  txt: 'Very strong' },
        ];
        const lvl = levels[score - 1] || levels[0];
        fill.style.width = lvl.pct;
        fill.className = 'progress-bar ' + lvl.cls;
        label.textContent = lvl.txt;
        label.className = 'small ' + lvl.cls.replace('bg-', 'text-');
    });
</script>
}
