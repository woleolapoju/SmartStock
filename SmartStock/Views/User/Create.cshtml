@model SmartStock.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Register User";
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
            <li class="breadcrumb-item active">Register</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2"></i>Register New User</h4>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <h6 class="fw-semibold text-muted mb-3 text-uppercase" style="font-size:.75rem;letter-spacing:.08em">
                    Account Details
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="John Smith" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="user@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1-555-0100" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <hr />
                <h6 class="fw-semibold text-muted mb-3 text-uppercase" style="font-size:.75rem;letter-spacing:.08em">
                    Role & Access
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" asp-items="Model.Roles" class="form-select" id="roleSelect"
                                onchange="toggleStoreField()">
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6" id="storeField" style="display:none">
                        <label asp-for="StoreId" class="form-label fw-semibold"></label>
                        <select asp-for="StoreId" asp-items="Model.Stores" class="form-select">
                            <option value="">-- Select Store --</option>
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch ms-1 mb-1">
                            <input asp-for="IsActive" class="form-check-input" role="switch" id="isActiveSwitch" />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">Active</label>
                        </div>
                    </div>
                </div>

                <hr />
                <h6 class="fw-semibold text-muted mb-3 text-uppercase" style="font-size:.75rem;letter-spacing:.08em">
                    Password
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" type="password" id="passwordInput" placeholder="Min 8 characters" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('passwordInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="mt-1">
                            <div id="strengthBar" class="progress" style="height:4px;display:none">
                                <div id="strengthFill" class="progress-bar" style="width:0%"></div>
                            </div>
                            <small id="strengthLabel" class="text-muted"></small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPasswordInput" placeholder="Repeat password" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPasswordInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-person-check me-1"></i>Register User
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Role Permissions</h6>
            <div class="mb-3">
                <span class="badge bg-danger mb-1">Admin</span>
                <p class="small text-muted mb-0">Full access to all modules — users, products, inventory, transfers, purchases, sales, and reports.</p>
            </div>
            <div class="mb-3">
                <span class="badge bg-primary mb-1">Warehouse Manager</span>
                <p class="small text-muted mb-0">Manages warehouse inventory, approves and dispatches stock transfers, creates purchase orders.</p>
            </div>
            <div class="mb-3">
                <span class="badge bg-success mb-1">Store Manager</span>
                <p class="small text-muted mb-0">Manages store inventory and stock adjustments, receives transfers, views sales and reports.</p>
            </div>
            <div>
                <span class="badge bg-secondary mb-1">Staff</span>
                <p class="small text-muted mb-0">Creates sales (POS) at their assigned store. Read-only access to inventory and product listings.</p>
            </div>
        </div>

        <div class="card p-4 mt-3">
            <h6 class="fw-semibold mb-2"><i class="bi bi-shield-lock me-2 text-warning"></i>Password Requirements</h6>
            <ul class="small text-muted mb-0 ps-3">
                <li>Minimum 8 characters</li>
                <li>At least one uppercase letter (A–Z)</li>
                <li>At least one lowercase letter (a–z)</li>
                <li>At least one digit (0–9)</li>
                <li>At least one special character (!@@#$%...)</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleStoreField() {
        const role = document.getElementById('roleSelect').value;
        const storeField = document.getElementById('storeField');
        storeField.style.display = (role === 'StoreManager' || role === 'Staff') ? '' : 'none';
    }

    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const isText = input.type === 'text';
        input.type = isText ? 'password' : 'text';
        btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
    }

    // Password strength meter
    document.getElementById('passwordInput').addEventListener('input', function() {
        const val = this.value;
        const bar = document.getElementById('strengthBar');
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');

        if (!val) { bar.style.display = 'none'; label.textContent = ''; return; }
        bar.style.display = '';

        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[a-z]/.test(val)) score++;
        if (/\d/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
            { pct: '20%', cls: 'bg-danger',  txt: 'Very weak' },
            { pct: '40%', cls: 'bg-warning',  txt: 'Weak' },
            { pct: '60%', cls: 'bg-info',     txt: 'Fair' },
            { pct: '80%', cls: 'bg-primary',  txt: 'Strong' },
            { pct: '100%',cls: 'bg-success',  txt: 'Very strong' },
        ];
        const lvl = levels[score - 1] || levels[0];
        fill.style.width = lvl.pct;
        fill.className = 'progress-bar ' + lvl.cls;
        label.textContent = lvl.txt;
        label.className = 'small ' + lvl.cls.replace('bg-', 'text-');
    });

    // Run on load to reflect server-side state
    toggleStoreField();
</script>
}
