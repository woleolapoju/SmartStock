@model IEnumerable<SmartStock.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>User Management</h4>
        <p class="text-muted mb-0 small">@Model.Count() user(s) found</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Register User
    </a>
</div>

<!-- Filters -->
<div class="card mb-3 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Search</label>
            <input type="text" name="search" class="form-control" placeholder="Name or email..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Role</label>
            <select name="role" class="form-select">
                <option value="">All Roles</option>
                @foreach (var r in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.RoleOptions)
                {
                    if (r.Value == ViewBag.SelectedRole?.ToString())
                    {
                        <option value="@r.Value" selected>@r.Text</option>
                    }
                    else
                    {
                        <option value="@r.Value">@r.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Status</label>
            <select name="active" class="form-select">
                <option value="">All</option>
                @if (ViewBag.ActiveFilter?.ToString() == "True")
                {
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                }
                else if (ViewBag.ActiveFilter?.ToString() == "False")
                {
                    <option value="true">Active</option>
                    <option value="false" selected>Inactive</option>
                }
                else
                {
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Assigned Store</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th style="width:140px"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr class="@(user.IsActive ? "" : "table-secondary text-muted")">
                    <td class="fw-medium">@user.FullName</td>
                    <td class="small">@user.Email</td>
                    <td class="small text-muted">@(user.PhoneNumber ?? "—")</td>
                    <td>
                        @{
                            var badgeClass = user.Role switch {
                                "Admin" => "bg-danger",
                                "WarehouseManager" => "bg-primary",
                                "StoreManager" => "bg-success",
                                "Staff" => "bg-secondary",
                                _ => "bg-light text-dark"
                            };
                        }
                        <span class="badge @badgeClass">@user.Role</span>
                    </td>
                    <td class="small text-muted">@(user.StoreName ?? "—")</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge-received">Active</span>
                        }
                        else
                        {
                            <span class="badge-cancelled">Inactive</span>
                        }
                    </td>
                    <td class="text-muted small">@user.CreatedAt.ToString("MM/dd/yyyy")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="ResetPassword" asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-warning" title="Reset Password">
                                <i class="bi bi-key"></i>
                            </a>
                            <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                        title="@(user.IsActive ? "Deactivate" : "Activate")"
                                        onclick="return confirm('@(user.IsActive ? "Deactivate" : "Activate") user @user.FullName?')">
                                    <i class="bi @(user.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No users found matching the filters.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
