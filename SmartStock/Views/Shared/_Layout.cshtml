<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStock</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #1a1f2e;
            --sidebar-hover: #2d3447;
            --accent: #4f7cff;
        }
        body { background: #f0f2f5; }
        #sidebar {
            width: var(--sidebar-width); min-height: 100vh;
            background: var(--sidebar-bg); position: fixed;
            top: 0; left: 0; transition: width 0.2s; z-index: 1000; overflow-x: hidden;
        }
        #sidebar .brand {
            padding: 1.25rem 1rem; color: #fff; font-weight: 700; font-size: 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }
        #sidebar .nav-link {
            color: rgba(255,255,255,.7); padding: .6rem 1.25rem; border-radius: 6px;
            margin: 2px 8px; display: flex; align-items: center; gap: .6rem; font-size: .9rem;
        }
        #sidebar .nav-link:hover, #sidebar .nav-link.active { background: var(--sidebar-hover); color: #fff; }
        #sidebar .nav-link.active { background: var(--accent); color: #fff; }
        #sidebar .nav-section {
            font-size: .7rem; text-transform: uppercase; letter-spacing: .1em;
            color: rgba(255,255,255,.35); padding: .75rem 1.25rem .25rem;
        }
        #main-content { margin-left: var(--sidebar-width); min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e5e7eb; padding: .75rem 1.5rem; }
        .kpi-card { border: none; border-radius: 12px; }
        .kpi-icon { width: 48px; height: 48px; border-radius: 10px; display:flex; align-items:center; justify-content:center; font-size: 1.4rem; }
        .badge-pending { background:#fef3c7;color:#92400e;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-approved { background:#dbeafe;color:#1e40af;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-dispatched { background:#ede9fe;color:#5b21b6;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-received { background:#d1fae5;color:#065f46;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-cancelled { background:#fee2e2;color:#991b1b;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-completed { background:#d1fae5;color:#065f46;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-voided { background:#fee2e2;color:#991b1b;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-ordered { background:#dbeafe;color:#1e40af;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .table th { font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:#6b7280;font-weight:600; }
        .page-hero { background:#fff;border-radius:12px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;box-shadow:0 1px 3px rgba(0,0,0,.05); }
        .card { border:none; box-shadow:0 1px 3px rgba(0,0,0,.06); border-radius:12px; }
        @@media (max-width: 768px) { #sidebar { width: 0; } #main-content { margin-left: 0; } }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <nav id="sidebar">
        <div class="brand">
            <i class="bi bi-boxes me-2" style="color:var(--accent)"></i>SmartStock
        </div>
        <div class="pt-2 pb-3">
            <div class="nav-section">Main</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>

            <div class="nav-section mt-2">Inventory</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
               asp-controller="Product" asp-action="Index">
                <i class="bi bi-box-seam"></i> Products
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")"
               asp-controller="Inventory" asp-action="Warehouse">
                <i class="bi bi-clipboard-data"></i> Inventory
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transfer" ? "active" : "")"
               asp-controller="Transfer" asp-action="Index">
                <i class="bi bi-arrow-left-right"></i> Transfers
            </a>

            <div class="nav-section mt-2">Commerce</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sale" ? "active" : "")"
               asp-controller="Sale" asp-action="Index">
                <i class="bi bi-cart3"></i> Sales (POS)
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase" ? "active" : "")"
               asp-controller="Purchase" asp-action="Index">
                <i class="bi bi-truck"></i> Purchases
            </a>

            <div class="nav-section mt-2">Management</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouse" ? "active" : "")"
               asp-controller="Warehouse" asp-action="Index">
                <i class="bi bi-building"></i> Warehouses
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Store" ? "active" : "")"
               asp-controller="Store" asp-action="Index">
                <i class="bi bi-shop"></i> Stores
            </a>

            <div class="nav-section mt-2">Reports</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")"
               asp-controller="Report" asp-action="Sales">
                <i class="bi bi-bar-chart-line"></i> Reports
            </a>
        </div>
    </nav>

    <div id="main-content">
        <div class="topbar d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (User.IsInRole("Admin"))
                { <span class="badge bg-danger">Admin</span> }
                else if (User.IsInRole("WarehouseManager"))
                { <span class="badge bg-primary">Warehouse Manager</span> }
                else if (User.IsInRole("StoreManager"))
                { <span class="badge bg-success">Store Manager</span> }
                else
                { <span class="badge bg-secondary">Staff</span> }
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:.85rem">
                            @(User.Identity?.Name?.FirstOrDefault() ?? 'U')
                        </div>
                        <span class="ms-2 small text-dark">@User.Identity?.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person me-2"></i>Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
}
else
{
    <div class="container mt-5">@RenderBody()</div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
