@inject SmartStock.Interfaces.ISystemParameterService _sysParamSvc
@{ var _sysParam = await _sysParamSvc.GetAsync(); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStock</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #1a1f2e;
            --sidebar-hover: #2d3447;
            --accent: #4f7cff;
        }

        /* ── Base ─────────────────────────────────────────────────────────────── */
        body { background: #f0f2f5; }

        /* ── Sidebar ──────────────────────────────────────────────────────────── */
        #sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0; left: 0;
            z-index: 1050;
            overflow-x: hidden;
            overflow-y: auto;
            transition: transform .28s cubic-bezier(.4,0,.2,1);
        }
        #sidebar .brand {
            padding: 1.25rem 1rem; color: #fff; font-weight: 700; font-size: 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            display: flex; align-items: center; justify-content: space-between;
        }
        #sidebar .brand-close {
            display: none;
            background: none; border: none; color: rgba(255,255,255,.5);
            font-size: 1.2rem; cursor: pointer; padding: 0 .25rem; line-height: 1;
        }
        #sidebar .nav-link {
            color: rgba(255,255,255,.7); padding: .6rem 1.25rem; border-radius: 6px;
            margin: 2px 8px; display: flex; align-items: center; gap: .6rem; font-size: .9rem;
        }
        #sidebar .nav-link:hover, #sidebar .nav-link.active { background: var(--sidebar-hover); color: #fff; }
        #sidebar .nav-link.active { background: var(--accent); color: #fff; }
        #sidebar .nav-section {
            font-size: .7rem; text-transform: uppercase; letter-spacing: .1em;
            color: rgba(255,255,255,.35); padding: .75rem 1.25rem .25rem;
        }

        /* ── Sidebar overlay (mobile) ─────────────────────────────────────────── */
        #sidebar-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1040;
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
        }
        #sidebar-overlay.show { display: block; }

        /* ── Main content ─────────────────────────────────────────────────────── */
        #main-content { margin-left: var(--sidebar-width); min-height: 100vh; }

        /* ── Topbar ───────────────────────────────────────────────────────────── */
        .topbar {
            background: linear-gradient(135deg, #ffffff 0%, #f5f7ff 100%);
            border-bottom: 1px solid #e5e7eb;
            padding: .7rem 1.5rem;
            box-shadow: 0 2px 8px rgba(79,124,255,.06);
            position: sticky; top: 0; z-index: 900;
        }
        .topbar-hamburger {
            display: none;
            background: none; border: none;
            font-size: 1.4rem; color: #374151;
            padding: 0 .4rem; cursor: pointer; line-height: 1;
        }
        .topbar-chip {
            display: inline-flex; align-items: center; gap: .4rem;
            background: #f0f2f8; border: 1px solid #e4e7f0;
            border-radius: 20px; padding: .28rem .85rem;
            font-size: .82rem; color: #374151; font-weight: 500;
            white-space: nowrap;
        }
        .topbar-chip i { font-size: .85rem; }
        .topbar-sep { width: 1px; height: 20px; background: #dde1ec; flex-shrink: 0; }
        .topbar-avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background: linear-gradient(135deg, #4f7cff, #7b5ea7);
            color: #fff; font-size: .8rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }

        /* ── KPI / Cards / Table ─────────────────────────────────────────────── */
        .kpi-card { border: none; border-radius: 12px; }
        .kpi-icon { width: 48px; height: 48px; border-radius: 10px; display:flex; align-items:center; justify-content:center; font-size: 1.4rem; }
        .badge-pending { background:#fef3c7;color:#92400e;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-approved { background:#dbeafe;color:#1e40af;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-dispatched { background:#ede9fe;color:#5b21b6;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-received { background:#d1fae5;color:#065f46;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-cancelled { background:#fee2e2;color:#991b1b;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-completed { background:#d1fae5;color:#065f46;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-voided { background:#fee2e2;color:#991b1b;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .badge-ordered { background:#dbeafe;color:#1e40af;padding:.35em .65em;border-radius:6px;font-size:.78em; }
        .table th { font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:#6b7280;font-weight:600; }
        .page-hero { background:#fff;border-radius:12px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;box-shadow:0 1px 3px rgba(0,0,0,.05); }
        .card { border:none; box-shadow:0 1px 3px rgba(0,0,0,.06); border-radius:12px; }

        /* ── Splash screen ────────────────────────────────────────────────────── */
        #splash {
            position: fixed; inset: 0; z-index: 9999;
            background: linear-gradient(135deg, #0f1623 0%, #1a1f2e 40%, #0d1b3e 100%);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 0;
            cursor: pointer;
            transition: opacity .6s ease, visibility .6s ease;
        }
        #splash.hiding { opacity: 0; visibility: hidden; }
        #splash-logo {
            width: 90px; height: 90px; border-radius: 24px;
            background: linear-gradient(135deg, #4f7cff 0%, #7b5ea7 100%);
            display: flex; align-items: center; justify-content: center;
            font-size: 2.8rem; color: #fff;
            box-shadow: 0 0 0 0 rgba(79,124,255,.5);
            animation: splashPulse 2s ease-in-out infinite;
            margin-bottom: 1.5rem;
        }
        @@keyframes splashPulse {
            0%,100% { box-shadow: 0 0 0 0 rgba(79,124,255,.4); }
            50%      { box-shadow: 0 0 0 18px rgba(79,124,255,0); }
        }
        #splash h1 {
            color: #fff; font-size: 2.4rem; font-weight: 800;
            letter-spacing: -.02em; margin-bottom: .4rem;
        }
        #splash h1 span { color: #4f7cff; }
        #splash p {
            color: rgba(255,255,255,.5); font-size: 1rem; margin-bottom: 2.5rem;
        }
        #splash-owner {
            color: rgba(255,255,255,.75); font-size: .95rem; margin-bottom: 2.5rem;
            letter-spacing: .02em;
        }
        #splash-progress-wrap {
            width: 220px; height: 4px;
            background: rgba(255,255,255,.1); border-radius: 2px; overflow: hidden;
            margin-bottom: 1.2rem;
        }
        #splash-progress {
            height: 100%; width: 0%;
            background: linear-gradient(90deg, #4f7cff, #7b5ea7);
            border-radius: 2px;
            transition: width linear;
        }
        #splash-hint {
            color: rgba(255,255,255,.3); font-size: .78rem; letter-spacing: .04em;
        }
        #splash-dots {
            display: flex; gap: .5rem; margin-top: .5rem;
        }
        #splash-dots span {
            width: 6px; height: 6px; border-radius: 50%;
            background: rgba(255,255,255,.2);
            animation: dotBounce 1.4s ease-in-out infinite;
        }
        #splash-dots span:nth-child(2) { animation-delay: .2s; }
        #splash-dots span:nth-child(3) { animation-delay: .4s; }
        @@keyframes dotBounce {
            0%,80%,100% { transform: scale(1); background: rgba(255,255,255,.2); }
            40%          { transform: scale(1.5); background: #4f7cff; }
        }

        /* ── Mobile breakpoint ────────────────────────────────────────────────── */
        @@media (max-width: 768px) {
            #sidebar { transform: translateX(-100%); }
            #sidebar.open { transform: translateX(0); }
            #sidebar .brand-close { display: block; }
            #main-content { margin-left: 0; }
            .topbar-hamburger { display: block; }
            .topbar { padding: .6rem 1rem; }
            .topbar-chip.hide-xs { display: none; }
            .topbar-sep.hide-xs { display: none; }
            .p-4 { padding: 1rem !important; }
        }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

<!-- ── Splash Screen ──────────────────────────────────────────────────────── -->
@if (User.Identity?.IsAuthenticated == true)
{
<div id="splash" onclick="dismissSplash()">
    <div id="splash-logo"><i class="bi bi-boxes"></i></div>
    <h1>Smart<span>Stock</span></h1>
    <p>Inventory Management System</p>
    <div id="splash-owner"><i class="bi bi-shield-check me-2" style="color:#4f7cff"></i>@_sysParam.OwnerName</div>
    <div id="splash-progress-wrap"><div id="splash-progress"></div></div>
    <div id="splash-hint">Click anywhere or press any key to continue</div>
    <div id="splash-dots"><span></span><span></span><span></span></div>
</div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Sidebar overlay for mobile -->
    <div id="sidebar-overlay" onclick="closeSidebar()"></div>

    <nav id="sidebar">
        <div class="brand">
            <span><i class="bi bi-boxes me-2" style="color:var(--accent)"></i>SmartStock</span>
            <button class="brand-close" onclick="closeSidebar()" aria-label="Close menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="pt-2 pb-3">
            <div class="nav-section">Main</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>

            <div class="nav-section mt-2">Inventory</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
               asp-controller="Product" asp-action="Index">
                <i class="bi bi-box-seam"></i> Products
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")"
               asp-controller="Inventory" asp-action="Warehouse">
                <i class="bi bi-clipboard-data"></i> Inventory
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transfer" ? "active" : "")"
               asp-controller="Transfer" asp-action="Index">
                <i class="bi bi-arrow-left-right"></i> Transfers
            </a>

            <div class="nav-section mt-2">Commerce</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sale" ? "active" : "")"
               asp-controller="Sale" asp-action="Index">
                <i class="bi bi-cart3"></i> Sales (POS)
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase" ? "active" : "")"
               asp-controller="Purchase" asp-action="Index">
                <i class="bi bi-truck"></i> Purchases
            </a>

            <div class="nav-section mt-2">Management</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouse" ? "active" : "")"
               asp-controller="Warehouse" asp-action="Index">
                <i class="bi bi-building"></i> Warehouses
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Store" ? "active" : "")"
               asp-controller="Store" asp-action="Index">
                <i class="bi bi-shop"></i> Stores
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
                   asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i> Users
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SystemParameter" ? "active" : "")"
                   asp-controller="SystemParameter" asp-action="Index">
                    <i class="bi bi-gear"></i> System Parameters
                </a>
            }

            <div class="nav-section mt-2">Reports</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")"
               asp-controller="Report" asp-action="Sales">
                <i class="bi bi-bar-chart-line"></i> Sales Report
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "active" : "")"
               asp-controller="Report" asp-action="Inventory">
                <i class="bi bi-clipboard-data"></i> Inventory Report
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "AdjustmentLog" ? "active" : "")"
               asp-controller="Report" asp-action="AdjustmentLog">
                <i class="bi bi-clipboard2-pulse"></i> Adjustment Log
            </a>
        </div>
    </nav>

    <div id="main-content">
        <div class="topbar d-flex justify-content-between align-items-center gap-2">
            <!-- Left: hamburger (mobile) + date + licensed-to chips -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="topbar-hamburger" onclick="openSidebar()" aria-label="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-chip hide-xs">
                    <i class="bi bi-calendar3 text-primary"></i>
                    @DateTime.Now.ToString("ddd, MMM dd yyyy")
                </span>
                <div class="topbar-sep hide-xs"></div>
                <span class="topbar-chip">
                    <i class="bi bi-shield-check text-success"></i>
                    <span class="text-muted d-none d-sm-inline" style="font-weight:400">Licensed to</span>
                    <span class="fw-semibold" style="color:#1a1f2e">@_sysParam.OwnerName</span>
                </span>
            </div>

            <!-- Right: role badge + user dropdown -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                @if (User.IsInRole("Admin"))
                { <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3">Admin</span> }
                else if (User.IsInRole("WarehouseManager"))
                { <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3">Warehouse Mgr</span> }
                else if (User.IsInRole("StoreManager"))
                { <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3">Store Mgr</span> }
                else
                { <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3">Staff</span> }

                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                        <div class="topbar-avatar">
                            @(User.Identity?.Name?.FirstOrDefault().ToString()?.ToUpper() ?? "U")
                        </div>
                        <span class="small fw-medium text-dark d-none d-md-inline" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@User.Identity?.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="min-width:200px">
                        <li class="px-3 py-2 text-muted small border-bottom">
                            <div class="fw-semibold text-dark" style="font-size:.85rem">@User.Identity?.Name</div>
                        </li>
                        <li><a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person me-2 text-primary"></i>My Profile</a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                <button class="dropdown-item py-2 text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
}
else
{
    <div class="container mt-5">@RenderBody()</div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    // ── Select2 ────────────────────────────────────────────────────────────────
    $(document).ready(function () {
        $('select:not(.no-select2):not([data-skip-select2])').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: $(this).data('placeholder') || '-- Select --',
            allowClear: true
        });
    });

    // ── Sidebar toggle (mobile) ─────────────────────────────────────────────
    function openSidebar() {
        document.getElementById('sidebar').classList.add('open');
        document.getElementById('sidebar-overlay').classList.add('show');
        document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebar-overlay').classList.remove('show');
        document.body.style.overflow = '';
    }
    // Auto-close sidebar when a nav link is tapped on mobile
    document.querySelectorAll('#sidebar .nav-link').forEach(function(link) {
        link.addEventListener('click', function() {
            if (window.innerWidth <= 768) closeSidebar();
        });
    });

    // ── Splash screen ───────────────────────────────────────────────────────
    (function() {
        var splash = document.getElementById('splash');
        if (!splash) return;

        var DURATION = 5000; // 5 seconds
        var progress = document.getElementById('splash-progress');
        var dismissed = false;

        function dismissSplash() {
            if (dismissed) return;
            dismissed = true;
            splash.classList.add('hiding');
            setTimeout(function() { splash.style.display = 'none'; }, 650);
        }
        window.dismissSplash = dismissSplash;

        // Animate progress bar
        progress.style.transition = 'width ' + DURATION + 'ms linear';
        requestAnimationFrame(function() {
            requestAnimationFrame(function() { progress.style.width = '100%'; });
        });

        // Auto-dismiss after DURATION
        setTimeout(dismissSplash, DURATION);

        // Dismiss on any key press
        document.addEventListener('keydown', dismissSplash, { once: true });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
