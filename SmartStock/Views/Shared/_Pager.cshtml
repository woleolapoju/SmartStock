@model PagerViewModel
@{
    int totalPages = Model.TotalPages;
    int currentPage = Math.Clamp(Model.CurrentPage, 1, totalPages);

    // Preserve every existing query-string param (search, filters, selected location...) except "page".
    var currentQuery = Context.Request.Query
        .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
        .ToDictionary(q => q.Key, q => q.Value.ToString());

    string PageUrl(int p)
    {
        var parts = new List<string>();
        foreach (var kv in currentQuery)
            parts.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}");
        parts.Add($"page={p}");
        return Context.Request.Path + "?" + string.Join("&", parts);
    }

    // Build the strip of page numbers to render, collapsing long runs behind an ellipsis.
    var pageItems = new List<int?>();
    if (totalPages <= 7)
    {
        for (int i = 1; i <= totalPages; i++) pageItems.Add(i);
    }
    else
    {
        pageItems.Add(1);
        if (currentPage > 4) pageItems.Add(null);
        for (int i = Math.Max(2, currentPage - 1); i <= Math.Min(totalPages - 1, currentPage + 1); i++)
            pageItems.Add(i);
        if (currentPage < totalPages - 3) pageItems.Add(null);
        pageItems.Add(totalPages);
    }
}

<div class="pager-bar">
    <div class="pager-info">
        @if (Model.TotalCount == 0)
        {
            <span>No @Model.ItemLabel to show</span>
        }
        else
        {
            <span>Showing <strong>@Model.RangeStart&ndash;@Model.RangeEnd</strong> of <strong>@Model.TotalCount</strong> @Model.ItemLabel</span>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Pages">
            <div class="pager-strip">
                <a class="pager-btn @(currentPage == 1 ? "disabled" : "")"
                   href="@PageUrl(1)" aria-label="First page" tabindex="@(currentPage == 1 ? "-1" : "0")">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
                <a class="pager-btn @(currentPage == 1 ? "disabled" : "")"
                   href="@PageUrl(Math.Max(1, currentPage - 1))" aria-label="Previous page" tabindex="@(currentPage == 1 ? "-1" : "0")">
                    <i class="bi bi-chevron-left"></i>
                </a>

                @foreach (var item in pageItems)
                {
                    if (item is null)
                    {
                        <span class="pager-ellipsis">&hellip;</span>
                    }
                    else
                    {
                        <a class="pager-btn @(item == currentPage ? "active" : "")"
                           href="@PageUrl(item.Value)" aria-label="Page @item" aria-current="@(item == currentPage ? "page" : null)">@item</a>
                    }
                }

                <a class="pager-btn @(currentPage == totalPages ? "disabled" : "")"
                   href="@PageUrl(Math.Min(totalPages, currentPage + 1))" aria-label="Next page" tabindex="@(currentPage == totalPages ? "-1" : "0")">
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a class="pager-btn @(currentPage == totalPages ? "disabled" : "")"
                   href="@PageUrl(totalPages)" aria-label="Last page" tabindex="@(currentPage == totalPages ? "-1" : "0")">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </div>
        </nav>
    }
</div>
