<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStock</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(ellipse at 30% 20%, #1e2a4a 0%, #0d1117 55%, #1a1225 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            position: relative;
            overflow: hidden;
        }

        /* Decorative background blobs */
        body::before {
            content: '';
            position: fixed;
            top: -200px; left: -200px;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(79,124,255,0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed;
            bottom: -150px; right: -150px;
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(139,92,246,0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .login-wrap {
            width: 100%;
            max-width: 430px;
            padding: 1.25rem;
            position: relative;
            z-index: 1;
        }

        .login-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 20px;
            padding: 2.75rem 2.25rem 2rem;
            box-shadow: 0 40px 80px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.04);
        }

        .brand-mark {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #4f7cff, #7c5cff);
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.6rem;
            box-shadow: 0 8px 24px rgba(79,124,255,0.35);
            margin: 0 auto 1rem;
        }

        .login-title  { color: #fff; font-weight: 700; font-size: 1.35rem; }
        .login-sub    { color: rgba(255,255,255,0.45); font-size: .875rem; }

        .form-label   { color: rgba(255,255,255,0.65); font-size: .82rem; font-weight: 500; margin-bottom: .35rem; }

        .input-group-text {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            border-right: none;
            color: rgba(255,255,255,0.45);
        }

        .form-control {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #fff;
            border-radius: 10px;
            padding: .72rem 1rem;
            font-size: .92rem;
            transition: border-color .2s, background .2s, box-shadow .2s;
        }
        .input-group .form-control {
            border-left: none;
            border-radius: 0 10px 10px 0;
        }
        .form-control::placeholder { color: rgba(255,255,255,0.25); }
        .form-control:focus {
            background: rgba(255,255,255,0.09);
            border-color: #4f7cff;
            box-shadow: 0 0 0 3px rgba(79,124,255,0.18);
            color: #fff;
            outline: none;
        }

        .form-check-input {
            background-color: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.2);
            width: 1.1em; height: 1.1em;
        }
        .form-check-input:checked {
            background-color: #4f7cff;
            border-color: #4f7cff;
        }
        .form-check-label { color: rgba(255,255,255,0.6); font-size: .85rem; }

        .btn-signin {
            background: linear-gradient(135deg, #4f7cff, #7c5cff);
            border: none;
            border-radius: 10px;
            padding: .78rem;
            font-weight: 600;
            font-size: .95rem;
            letter-spacing: .03em;
            color: #fff;
            transition: opacity .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 20px rgba(79,124,255,0.35);
        }
        .btn-signin:hover   { opacity: .9; transform: translateY(-1px); box-shadow: 0 8px 28px rgba(79,124,255,0.4); color: #fff; }
        .btn-signin:active  { transform: translateY(0); }
        .btn-signin:disabled { opacity: .6; transform: none; }

        .text-danger, .validation-summary-errors li { color: #fc8181 !important; font-size: .82rem; }

        .alert-login-error {
            background: rgba(252,129,129,0.1);
            border: 1px solid rgba(252,129,129,0.25);
            border-radius: 10px;
            color: #fc8181;
            padding: .75rem 1rem;
            font-size: .85rem;
        }

        .divider-line {
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .hint-box {
            background: rgba(79,124,255,0.08);
            border: 1px solid rgba(79,124,255,0.2);
            border-radius: 10px;
            padding: .85rem 1rem;
            margin-top: 1.25rem;
        }
        .hint-box p { color: rgba(255,255,255,0.55); font-size: .78rem; margin: 0; line-height: 1.6; }
        .hint-box code { color: #7cb3ff; background: rgba(79,124,255,0.15); padding: 0 .3em; border-radius: 4px; }
    </style>
</head>
<body>
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
