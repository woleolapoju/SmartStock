@model SmartStock.Models.Store
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Stores</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">@Model.Name</h4>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Store Information</h6>
            <dl class="row">
                <dt class="col-4 text-muted small">Status</dt>
                <dd class="col-8">@(Model.IsActive ? "<span class='badge-received'>Active</span>" : "<span class='badge-cancelled'>Inactive</span>")</dd>
                <dt class="col-4 text-muted small">Address</dt>
                <dd class="col-8 small">@(Model.Address ?? "—")</dd>
                <dt class="col-4 text-muted small">Phone</dt>
                <dd class="col-8 small">@(Model.Phone ?? "—")</dd>
                <dt class="col-4 text-muted small">Email</dt>
                <dd class="col-8 small">@(Model.Email ?? "—")</dd>
                <dt class="col-4 text-muted small">Created</dt>
                <dd class="col-8 small">@Model.CreatedAt.ToString("MM/dd/yyyy")</dd>
            </dl>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Assigned Users (@Model.Users.Count)</h6>
            @foreach (var user in Model.Users)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:28px;height:28px;font-size:.75rem">
                        @user.FullName.FirstOrDefault()
                    </div>
                    <div>
                        <div class="small fw-medium">@user.FullName</div>
                        <div class="text-muted" style="font-size:.75rem">@user.Email</div>
                    </div>
                </div>
            }
            @if (!Model.Users.Any())
            {
                <p class="text-muted small">No users assigned to this store.</p>
            }
        </div>
    </div>
</div>
