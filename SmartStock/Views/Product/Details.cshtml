@model SmartStock.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">@Model.Name</h4>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card p-4">
            <div class="row g-3">
                <div class="col-6">
                    <div class="text-muted small">SKU</div>
                    <code class="fs-6">@Model.SKU</code>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Barcode</div>
                    <div>@(Model.Barcode ?? "—")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Category</div>
                    <div>@Model.Category?.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Status</div>
                    @if (Model.IsActive)
                    { <span class="badge-received">Active</span> }
                    else
                    { <span class="badge-cancelled">Inactive</span> }
                </div>
                <div class="col-6">
                    <div class="text-muted small">Cost Price</div>
                    <div class="fs-5">$@Model.CostPrice.ToString("N2")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Selling Price</div>
                    <div class="fs-5 fw-bold text-primary">$@Model.Price.ToString("N2")</div>
                </div>
                <div class="col-12">
                    <div class="text-muted small">Description</div>
                    <div>@(Model.Description ?? "—")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Created</div>
                    <div class="small">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small">Last Updated</div>
                    <div class="small">@Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4">
            <h6 class="fw-semibold mb-3">Quick Actions</h6>
            <div class="d-grid gap-2">
                <a asp-controller="Inventory" asp-action="Warehouse" class="btn btn-outline-primary">
                    <i class="bi bi-clipboard-data me-1"></i>View Inventory
                </a>
                <a asp-controller="Transfer" asp-action="Create" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-right me-1"></i>Create Transfer
                </a>
            </div>
        </div>
    </div>
</div>
