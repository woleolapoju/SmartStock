@model SmartStock.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Products";
    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Products</h4>
        <p class="text-muted mb-0 small">@Model.TotalCount products found</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Product
        </a>
    }
</div>

<!-- Search & Filter -->
<div class="card mb-3 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-semibold">Search</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Name, SKU, or Barcode..." />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Category</label>
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    if (cat.Value == Model.CategoryId?.ToString())
                    {
                        <option value="@cat.Value" selected>@cat.Text</option>
                    }
                    else
                    {
                        <option value="@cat.Value">@cat.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th><th>SKU</th><th>Category</th>
                    <th>Cost Price</th><th>Selling Price</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Products)
            {
                <tr>
                    <td>
                        <div class="fw-medium">@p.Name</div>
                        @if (!string.IsNullOrEmpty(p.Barcode))
                        {
                            <div class="text-muted" style="font-size:.75rem"><i class="bi bi-upc me-1"></i>@p.Barcode</div>
                        }
                    </td>
                    <td><code class="small">@p.SKU</code></td>
                    <td><span class="badge bg-light text-dark">@p.Category?.Name</span></td>
                    <td>$@p.CostPrice.ToString("N2")</td>
                    <td class="fw-medium">$@p.Price.ToString("N2")</td>
                    <td>
                        @if (p.IsActive)
                        { <span class="badge-received">Active</span> }
                        else
                        { <span class="badge-cancelled">Inactive</span> }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager"))
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Deactivate this product?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Products.Any())
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">No products found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
