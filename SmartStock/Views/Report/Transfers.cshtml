@model IEnumerable<SmartStock.Models.StockTransfer>
@using SmartStock.Models
@{
    ViewData["Title"] = "Transfers Report";
}

@section Head {
<style>
    @@media print {
        #sidebar, #sidebar-overlay, .topbar, .no-print { display: none !important; }
        #main-content { margin-left: 0 !important; }
        .card { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
        .page-hero { box-shadow: none !important; }
        a.btn { display: none !important; }
    }
</style>
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-arrow-left-right me-2"></i>Transfers Report</h4>
        <p class="text-muted mb-0 small">@ViewBag.From &ndash; @ViewBag.To &nbsp;&bull;&nbsp; @Model.Count() transfer(s)</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Purchases" class="btn btn-outline-secondary btn-sm">Purchases Report</a>
        <a asp-action="Sales" class="btn btn-outline-secondary btn-sm">Sales Report</a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3 p-3 no-print">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-semibold">From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.StatusOptions)
                {
                    if (s.Value == ViewBag.Status?.ToString())
                    {
                        <option value="@s.Value" selected>@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Warehouse</label>
            <select name="warehouseId" class="form-select">
                <option value="">All Warehouses</option>
                @foreach (var w in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Warehouses)
                {
                    if (w.Value == ViewBag.SelectedWarehouseId?.ToString())
                    {
                        <option value="@w.Value" selected>@w.Text</option>
                    }
                    else
                    {
                        <option value="@w.Value">@w.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Store</label>
            <select name="storeId" class="form-select">
                <option value="">All Stores</option>
                @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Stores)
                {
                    if (s.Value == ViewBag.SelectedStoreId?.ToString())
                    {
                        <option value="@s.Value" selected>@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Apply</button>
        </div>
    </form>
</div>

<!-- KPI Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Total Transfers</div>
            <div class="fs-4 fw-bold">@ViewBag.TotalTransfers</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Received</div>
            <div class="fs-4 fw-bold text-success">@ViewBag.ReceivedTransfers</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">In Transit</div>
            <div class="fs-4 fw-bold text-primary">@ViewBag.InTransit</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Pending / Approved</div>
            <div class="fs-4 fw-bold text-warning">@ViewBag.PendingTransfers</div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Reference</th>
                    <th>Warehouse</th>
                    <th>Store</th>
                    <th>Items</th>
                    <th>Units</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Dispatched</th>
                    <th>Received</th>
                    <th class="no-print"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="fw-medium">@t.ReferenceNumber</td>
                    <td>@t.Warehouse?.Name</td>
                    <td>@t.Store?.Name</td>
                    <td>@t.Items.Count</td>
                    <td>@t.Items.Sum(i => i.Quantity)</td>
                    <td><span class="badge-@t.Status.ToString().ToLower()">@t.Status</span></td>
                    <td class="text-muted small">@t.CreatedAt.ToString("MM/dd/yyyy")</td>
                    <td class="text-muted small">@(t.DispatchedAt?.ToString("MM/dd/yyyy") ?? "—")</td>
                    <td class="text-muted small">@(t.ReceivedAt?.ToString("MM/dd/yyyy") ?? "—")</td>
                    <td class="no-print">
                        <a asp-controller="Transfer" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center py-4 text-muted">No transfers found for the selected filters.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
