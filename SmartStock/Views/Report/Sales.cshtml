@model IEnumerable<SmartStock.Models.Sale>
@{
    ViewData["Title"] = "Sales Report";
}

<div class="page-hero">
    <h4 class="mb-0 fw-bold"><i class="bi bi-bar-chart-line me-2"></i>Sales Report</h4>
</div>

<!-- Filters -->
<div class="card mb-3 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Store</label>
            <select name="storeId" class="form-select">
                <option value="">All Stores</option>
                @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Stores)
                {
                    if (s.Value == ViewBag.SelectedStoreId?.ToString())
                    {
                        <option value="@s.Value" selected>@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Apply</button>
        </div>
    </form>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Total Revenue</div>
            <div class="fs-4 fw-bold text-primary">$@ViewBag.TotalRevenue?.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Transactions</div>
            <div class="fs-4 fw-bold">@ViewBag.TotalTransactions</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Avg. Transaction</div>
            <div class="fs-4 fw-bold">
                @if ((int)(ViewBag.TotalTransactions ?? 0) > 0)
                { <text>$@(((decimal)ViewBag.TotalRevenue / (int)ViewBag.TotalTransactions).ToString("N2"))</text> }
                else { <text>—</text> }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Reference</th><th>Store</th><th>Cashier</th><th>Items</th><th>Subtotal</th><th>Tax</th><th>Total</th><th>Date</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-medium">@s.ReferenceNumber</td>
                    <td>@s.Store?.Name</td>
                    <td class="text-muted small">@(s.Cashier?.FullName ?? "—")</td>
                    <td>@s.Items.Sum(i => i.Quantity)</td>
                    <td>$@s.SubTotal.ToString("N2")</td>
                    <td>$@s.TaxAmount.ToString("N2")</td>
                    <td class="fw-bold">$@s.TotalAmount.ToString("N2")</td>
                    <td class="text-muted small">@s.SaleDate.ToString("MM/dd HH:mm")</td>
                    <td>
                        <a asp-controller="Sale" asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center py-4 text-muted">No sales in this period.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-controller="Report" asp-action="Inventory" class="btn btn-outline-secondary">Inventory Report</a>
    <a asp-controller="Report" asp-action="Transfers" class="btn btn-outline-secondary">Transfers Report</a>
</div>
