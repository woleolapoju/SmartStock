@model IEnumerable<SmartStock.Models.StockAdjustmentLog>
@using SmartStock.Models
@{
    ViewData["Title"] = "Stock Adjustment Log";
    var warehouseNames = ViewBag.WarehouseNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var storeNames = ViewBag.StoreNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}

@section Head {
<style>
    @@media screen { .print-header { display: none; } }
    @@media print {
        @@page { margin: 1.5cm; }
        #sidebar, #sidebar-overlay, .topbar, .no-print { display: none !important; }
        #main-content { margin-left: 0 !important; padding: 0 !important; }
        body { background: #fff !important; font-family: Arial, sans-serif !important; font-size: 10pt !important; color: #000 !important; }
        .print-header { display: block !important; text-align: center; padding-bottom: 10pt; margin-bottom: 14pt; border-bottom: 2px solid #000; }
        .print-header .ph-company { font-size: 16pt; font-weight: bold; letter-spacing: .04em; }
        .print-header .ph-title   { font-size: 13pt; margin: 2pt 0; }
        .print-header .ph-meta    { font-size: 8.5pt; color: #444; }
        .page-hero { box-shadow: none !important; border-radius: 0 !important; border: none !important; background: #fff !important; padding: 0 0 8pt !important; margin-bottom: 10pt !important; }
        .page-hero h4 { font-size: 12pt !important; }
        .page-hero p  { display: none !important; }
        .card { box-shadow: none !important; border-radius: 0 !important; border: none !important; }
        .table { font-size: 9pt !important; border-collapse: collapse !important; width: 100% !important; }
        .table th, .table td { border: 1px solid #666 !important; padding: 3pt 5pt !important; }
        .table thead.table-light th { background: #ececec !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-weight: bold; }
        .table-hover tbody tr:hover td { background: transparent !important; }
        .badge { background: #eee !important; color: #000 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        a { color: #000 !important; text-decoration: none !important; }
        code { font-family: Arial, sans-serif !important; background: none !important; }
        .text-success { color: #000 !important; }
        .text-danger  { color: #000 !important; }
    }
</style>
}

<div class="print-header">
    <div class="ph-company">SmartStock</div>
    <div class="ph-title">Stock Adjustment Log</div>
    <div class="ph-meta">Period: @ViewBag.From &ndash; @ViewBag.To &nbsp;|&nbsp; Printed: @DateTime.Now.ToString("MM/dd/yyyy HH:mm")</div>
</div>

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-clipboard2-pulse me-2"></i>Stock Adjustment Log</h4>
        <p class="text-muted mb-0 small">@Model.Count() adjustment(s) in selected period</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Sales" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bar-chart-line me-1"></i>Sales Report</a>
        <a asp-action="Inventory" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clipboard-data me-1"></i>Inventory Report</a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3 p-3 no-print">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-semibold">From</label>
            <input type="date" name="from" class="form-control" value="@ViewBag.From" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">To</label>
            <input type="date" name="to" class="form-control" value="@ViewBag.To" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Product</label>
            <select name="productId" class="form-select">
                <option value="">All Products</option>
                @foreach (var p in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Products)
                {
                    if (p.Value == ViewBag.SelectedProductId?.ToString())
                    {
                        <option value="@p.Value" selected>@p.Text</option>
                    }
                    else
                    {
                        <option value="@p.Value">@p.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Location Type</label>
            <select name="locationType" class="form-select" id="locationTypeFilter" onchange="toggleLocationDropdown()">
                <option value="">All</option>
                @foreach (var lt in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.LocationTypeOptions)
                {
                    if (lt.Value == ((int?)ViewBag.SelectedLocationType)?.ToString())
                    {
                        <option value="@lt.Value" selected>@lt.Text</option>
                    }
                    else
                    {
                        <option value="@lt.Value">@lt.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2" id="warehouseFilterDiv">
            <label class="form-label small fw-semibold">Warehouse</label>
            <select name="locationId" class="form-select">
                <option value="">All</option>
                @foreach (var w in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Warehouses)
                {
                    if (w.Value == ViewBag.SelectedLocationId?.ToString())
                    {
                        <option value="@w.Value" selected>@w.Text</option>
                    }
                    else
                    {
                        <option value="@w.Value">@w.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-none" id="storeFilterDiv">
            <label class="form-label small fw-semibold">Store</label>
            <select name="locationId" class="form-select">
                <option value="">All</option>
                @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Stores)
                {
                    if (s.Value == ViewBag.SelectedLocationId?.ToString())
                    {
                        <option value="@s.Value" selected>@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date / Time</th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Location</th>
                    <th class="text-center">Before</th>
                    <th class="text-center">Change</th>
                    <th class="text-center">After</th>
                    <th>Reason</th>
                    <th>Adjusted By</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var log in Model)
            {
                var locationName = log.LocationType == LocationType.Warehouse
                    ? (warehouseNames.TryGetValue(log.LocationId, out var wn) ? wn : $"Warehouse #{log.LocationId}")
                    : (storeNames.TryGetValue(log.LocationId, out var sn) ? sn : $"Store #{log.LocationId}");
                <tr>
                    <td class="text-muted small">@log.AdjustedAt.ToString("MM/dd/yyyy HH:mm")</td>
                    <td class="fw-medium">@log.Product?.Name</td>
                    <td><code class="small">@log.Product?.SKU</code></td>
                    <td>
                        <span class="badge @(log.LocationType == LocationType.Warehouse ? "bg-primary" : "bg-success") bg-opacity-10 text-dark">
                            <i class="bi @(log.LocationType == LocationType.Warehouse ? "bi-building" : "bi-shop") me-1"></i>@locationName
                        </span>
                    </td>
                    <td class="text-center">@log.QuantityBefore</td>
                    <td class="text-center">
                        @if (log.QuantityChange > 0)
                        {
                            <span class="fw-bold text-success">+@log.QuantityChange</span>
                        }
                        else
                        {
                            <span class="fw-bold text-danger">@log.QuantityChange</span>
                        }
                    </td>
                    <td class="text-center fw-bold">@log.QuantityAfter</td>
                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(log.Reason) ? "—" : log.Reason)</td>
                    <td class="text-muted small">@(log.AdjustedBy?.UserName ?? "—")</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">No adjustment logs found for the selected filters.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function toggleLocationDropdown() {
        const lt = document.getElementById('locationTypeFilter').value;
        document.getElementById('warehouseFilterDiv').classList.toggle('d-none', lt === '2');
        document.getElementById('storeFilterDiv').classList.toggle('d-none', lt !== '2');
    }
    // Apply on page load based on current selection
    toggleLocationDropdown();
</script>
}
