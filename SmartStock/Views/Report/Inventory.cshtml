@model IEnumerable<SmartStock.ViewModels.InventoryViewModel>
@{
    ViewData["Title"] = "Inventory Report";
    string cur = ViewBag.CurrencySymbol ?? "";
    string location = ViewBag.Location ?? "";
    string locationLabel = ViewBag.LocationLabel ?? "All Locations";
    string categoryLabel = ViewBag.CategoryLabel ?? "All Categories";
    int? categoryId = ViewBag.CategoryId;
    var categoryOpts = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories;
    var warehouseOpts = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Warehouses;
    var storeOpts = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Stores;

    decimal totalCost = Model.Sum(i => i.CostValue);
    decimal totalSelling = Model.Sum(i => i.SellingValue);
    decimal totalPL = totalSelling - totalCost;

    string Money(decimal v) => (v < 0 ? "-" : "") + cur + Math.Abs(v).ToString("N2");
}

@section Head {
<style>
    @@media screen { .print-header { display: none; } }
    @@media print {
        @@page { margin: 1.5cm; }
        #sidebar, #sidebar-overlay, .topbar, .no-print { display: none !important; }
        #main-content { margin-left: 0 !important; padding: 0 !important; }
        body { background: #fff !important; font-family: Arial, sans-serif !important; font-size: 10pt !important; color: #000 !important; }
        .print-header { display: block !important; text-align: center; padding-bottom: 10pt; margin-bottom: 14pt; border-bottom: 2px solid #000; }
        .print-header .ph-company { font-size: 16pt; font-weight: bold; letter-spacing: .04em; }
        .print-header .ph-title   { font-size: 13pt; margin: 2pt 0; }
        .print-header .ph-meta    { font-size: 8.5pt; color: #444; }
        .page-hero { box-shadow: none !important; border-radius: 0 !important; border: none !important; background: #fff !important; padding: 0 0 8pt !important; margin-bottom: 10pt !important; }
        .page-hero h4 { font-size: 12pt !important; }
        .page-hero p  { display: none !important; }
        .card { box-shadow: none !important; border-radius: 0 !important; border: none !important; }
        .kpi-card { border: 1px solid #bbb !important; page-break-inside: avoid; }
        .row { display: flex !important; flex-wrap: wrap !important; }
        .col-md-4 { width: 33.333% !important; box-sizing: border-box !important; padding: 4pt !important; }
        .col-md-3 { width: 25% !important; box-sizing: border-box !important; padding: 4pt !important; }
        .table { font-size: 9pt !important; border-collapse: collapse !important; width: 100% !important; }
        .table th, .table td { border: 1px solid #666 !important; padding: 3pt 5pt !important; }
        .table thead.table-light th { background: #ececec !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-weight: bold; }
        .table-hover tbody tr:hover td { background: transparent !important; }
        .table-warning td, .table-danger td { background: #fff !important; }
        .table tfoot td { background: #ececec !important; font-weight: bold; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .text-success, .text-danger { color: #000 !important; }
        [class^="badge-"] { background: #fff !important; border: 1px solid #666 !important; color: #000 !important; padding: 1pt 3pt !important; font-size: 8pt !important; border-radius: 3pt; }
        .badge { background: #eee !important; color: #000 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        a { color: #000 !important; text-decoration: none !important; }
        .fs-4 { font-size: 13pt !important; }
        code { font-family: Arial, sans-serif !important; background: none !important; }
    }
</style>
}

<div class="print-header">
    <div class="ph-company">SmartStock</div>
    <div class="ph-title">Inventory Report</div>
    <div class="ph-meta">@locationLabel &nbsp;|&nbsp; @categoryLabel &nbsp;|&nbsp; Printed: @DateTime.Now.ToString("MM/dd/yyyy HH:mm")</div>
</div>

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold"><i class="bi bi-clipboard-data me-2"></i>Inventory Report</h4>
        <p class="text-muted mb-0 small">@locationLabel · @categoryLabel — @Model.Count() records</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <a asp-action="InventoryExport" asp-route-location="@location" asp-route-categoryId="@categoryId" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
        </a>
        <a asp-action="InventoryPrint" asp-route-location="@location" asp-route-categoryId="@categoryId" target="_blank" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i>Print
        </a>
        <a asp-controller="Report" asp-action="Sales" class="btn btn-outline-secondary btn-sm">Sales Report</a>
        <a asp-controller="Report" asp-action="Transfers" class="btn btn-outline-secondary btn-sm">Transfers Report</a>
    </div>
</div>

<div class="card mb-3 p-3 no-print">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Location</label>
            <select name="location" class="form-select" onchange="this.form.submit()" data-skip-select2="true">
                <option value="" selected="@(location == "")">All Locations</option>
                <option value="w" selected="@(location == "w")">All Warehouses</option>
                <option value="s" selected="@(location == "s")">All Stores</option>
                <optgroup label="Warehouses">
                    @foreach (var w in warehouseOpts)
                    {
                        <option value="@w.Value" selected="@(location == w.Value)">@w.Text</option>
                    }
                </optgroup>
                <optgroup label="Stores">
                    @foreach (var st in storeOpts)
                    {
                        <option value="@st.Value" selected="@(location == st.Value)">@st.Text</option>
                    }
                </optgroup>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Category</label>
            <select name="categoryId" class="form-select" asp-items="categoryOpts" onchange="this.form.submit()" data-skip-select2="true">
                <option value="">All Categories</option>
            </select>
        </div>
        @if (location != "" || categoryId.HasValue)
        {
            <div class="col-auto">
                <a asp-action="Inventory" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Clear</a>
            </div>
        }
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Total SKUs</div>
            <div class="fs-4 fw-bold">@Model.Select(i => i.ProductId).Distinct().Count()</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Total Units</div>
            <div class="fs-4 fw-bold">@Model.Sum(i => i.Quantity).ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Low Stock Items</div>
            <div class="fs-4 fw-bold text-warning">@Model.Count(i => i.IsLowStock)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Out of Stock</div>
            <div class="fs-4 fw-bold text-danger">@Model.Count(i => i.Quantity == 0)</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Stock Value at Cost</div>
            <div class="fs-4 fw-bold">@Money(totalCost)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Stock Value at Selling Price</div>
            <div class="fs-4 fw-bold text-primary">@Money(totalSelling)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 kpi-card">
            <div class="text-muted small">Potential Profit / Loss</div>
            <div class="fs-4 fw-bold @(totalPL < 0 ? "text-danger" : "text-success")">@Money(totalPL)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Product</th><th class="no-print">SKU</th><th>Category</th><th>Location</th><th class="no-print">Type</th><th class="text-end">Qty</th><th class="text-end no-print">Reorder</th><th class="no-print">Status</th><th class="text-end">Qty × Cost</th><th class="text-end">Qty × Selling</th><th class="text-end">P/L</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.Quantity == 0 ? "table-danger" : item.IsLowStock ? "table-warning" : "")">
                    <td class="fw-medium">@item.ProductName</td>
                    <td class="no-print"><code class="small">@item.SKU</code></td>
                    <td><span class="badge bg-light text-dark">@item.CategoryName</span></td>
                    <td>@item.LocationName</td>
                    <td class="no-print">
                        @if (item.LocationType == SmartStock.Models.LocationType.Warehouse)
                        { <span class="badge bg-primary">Warehouse</span> }
                        else
                        { <span class="badge bg-success">Store</span> }
                    </td>
                    <td class="fw-bold text-end">@item.Quantity.ToString("N0")</td>
                    <td class="text-muted text-end no-print">@item.ReorderLevel</td>
                    <td class="no-print">
                        @if (item.Quantity == 0) { <span class="badge-cancelled">Out of Stock</span> }
                        else if (item.IsLowStock) { <span class="badge-pending">Low Stock</span> }
                        else { <span class="badge-received">OK</span> }
                    </td>
                    <td class="text-end">@Money(item.CostValue)</td>
                    <td class="text-end">@Money(item.SellingValue)</td>
                    <td class="text-end fw-semibold @(item.ProfitLoss < 0 ? "text-danger" : "text-success")">@Money(item.ProfitLoss)</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="11" class="text-center py-4 text-muted">No inventory for @locationLabel (@categoryLabel).</td></tr>
            }
            </tbody>
            @if (Model.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td>Total</td>
                        <td class="no-print"></td>
                        <td></td>
                        <td></td>
                        <td class="no-print"></td>
                        <td class="text-end">@Model.Sum(i => i.Quantity).ToString("N0")</td>
                        <td class="no-print"></td>
                        <td class="no-print"></td>
                        <td class="text-end">@Money(totalCost)</td>
                        <td class="text-end">@Money(totalSelling)</td>
                        <td class="text-end @(totalPL < 0 ? "text-danger" : "text-success")">@Money(totalPL)</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
