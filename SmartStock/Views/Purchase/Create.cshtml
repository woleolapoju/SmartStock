@model SmartStock.ViewModels.CreatePurchaseViewModel
@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
    <h4 class="mb-0 fw-bold">New Purchase Order</h4>
</div>

<div class="row">
    <div class="col-md-9">
        <div class="card p-4">
            <form asp-action="Create" method="post" id="purchaseForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="WarehouseId" class="form-label fw-semibold">Receiving Warehouse</label>
                        <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SupplierName" class="form-label fw-semibold">Supplier</label>
                        <input asp-for="SupplierName" class="form-control" placeholder="Supplier name..." />
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0">Order Items</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addItemBtn">
                        <i class="bi bi-plus-lg me-1"></i>Add Item
                    </button>
                </div>
                <div id="summaryTotal" class="text-end fw-bold fs-6 mb-3 text-primary">Total: $0.00</div>
                <div id="itemsContainer"></div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-truck me-1"></i>Create Purchase Order
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Products.Select(p => new { value = p.Value, text = p.Text })
    ));
    let itemIndex = 0;

    function recalculate() {
        let total = 0;
        document.querySelectorAll('.item-row').forEach(row => {
            const qty = parseFloat(row.querySelector('.qty-input')?.value || 0);
            const cost = parseFloat(row.querySelector('.cost-input')?.value || 0);
            total += qty * cost;
        });
        document.getElementById('summaryTotal').textContent = 'Total: $' + total.toFixed(2);
    }

    function addItem() {
        const container = document.getElementById('itemsContainer');
        const idx = itemIndex++;
        const div = document.createElement('div');
        div.className = 'row g-2 align-items-end mb-3 item-row border-bottom pb-3';
        div.innerHTML = `
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Product</label>
                <select name="Items[${idx}].ProductId" class="form-select" required>
                    <option value="">-- Select --</option>
                    ${products.map(p => `<option value="${p.value}">${p.text}</option>`).join('')}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Qty</label>
                <input type="number" name="Items[${idx}].Quantity" class="form-control qty-input" min="1" value="1" required oninput="recalculate()" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Unit Cost</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" name="Items[${idx}].UnitCost" class="form-control cost-input" step="0.01" min="0.01" required oninput="recalculate()" />
                </div>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-outline-danger w-100" onclick="this.closest('.item-row').remove(); recalculate()">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.appendChild(div);
    }

    document.getElementById('addItemBtn').addEventListener('click', addItem);
    addItem();
</script>
}
