@model IEnumerable<SmartStock.Models.Purchase>
@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="page-hero d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Purchase Orders</h4>
        <p class="text-muted mb-0 small">@Model.Count() orders</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("WarehouseManager"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Purchase Order
        </a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Reference</th><th>Warehouse</th><th>Supplier</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-medium">@p.ReferenceNumber</td>
                    <td>@p.Warehouse?.Name</td>
                    <td class="text-muted">@(p.SupplierName ?? "—")</td>
                    <td class="fw-bold">@ViewBag.CurrencySymbol@p.TotalAmount.ToString("N2")</td>
                    <td><span class="badge-@p.Status.ToString().ToLower()">@p.Status</span></td>
                    <td class="text-muted small">@p.PurchaseDate.ToString("MM/dd/yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">No purchase orders yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
